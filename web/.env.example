# Astro front-end — environment variables
# Copy this file to .env and fill in values for local development.
# Never commit .env — only .env.example is tracked.

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public URL of the website itself
# Local:    http://localhost:4321
# Live:     https://web-production-2a3c3.up.railway.app
PUBLIC_SITE_URL=http://localhost:4321

# Public URL of the CMS (used for media, preview, admin links shown to users)
# Local:    http://localhost:1337
# Live:     https://cms-production-3644.up.railway.app
CMS_PUBLIC_URL=http://localhost:1337

# Internal URL of the CMS (used for SSR API calls — faster, no public internet)
# Local:    http://localhost:1337
# Live:     http://cms.railway.internal:1337
CMS_INTERNAL_URL=http://localhost:1337

# ── Strapi ────────────────────────────────────────────────────────────────────
# Read-only API token — create in Strapi admin → Settings → API Tokens
STRAPI_API_TOKEN=

# HMAC secret for revalidation webhook (must match Strapi webhook secret)
REVALIDATE_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:twh_redis_secret@localhost:6379

# ── Object storage (for the media proxy at /media/[...path]) ─────────────────
BUCKET_ENDPOINT=http://localhost:9000
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=twh_access
BUCKET_SECRET_ACCESS_KEY=twh_secret_key_local
BUCKET_NAME=wolverinehub-media
BUCKET_FORCE_PATH_STYLE=true

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
# Get keys from Cloudflare Dashboard → Turnstile
# Use the test keys below for local development (always pass)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Payments ─────────────────────────────────────────────────────────────────
# preview = full UI, no real payment calls
# sandbox = PayHere sandbox
# live    = real payments (Railway production only)
PAYMENT_MODE=preview
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# EDGE_CHECK=false means the Cloudflare origin header check is disabled
# (keep false until Cloudflare is wired up at go-live)
EDGE_CHECK=false
# TWH_EDGE_SECRET=       # Must match the Cloudflare Transform Rule secret

# ── Indexing ──────────────────────────────────────────────────────────────────
# false = X-Robots-Tag: noindex + Disallow: / in robots.txt
# true  = normal indexing (set on Railway at go-live)
SITE_INDEXING=false

# ── Go-live ───────────────────────────────────────────────────────────────────
# GO_LIVE_DATE=          # Set on Railway at launch (format: YYYY-MM-DD)
