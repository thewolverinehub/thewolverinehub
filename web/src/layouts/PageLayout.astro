---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SlashMenu from '../components/layout/SlashMenu.astro';
import type { StrapiSeo, StrapiGlobal, StrapiHeader, StrapiFooter } from '../lib/strapi/types';
import { getHeader, getFooter } from '../lib/strapi/queries';

interface Props {
  seo?: StrapiSeo;
  global?: StrapiGlobal;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { seo, global, jsonLd, noindex } = Astro.props;

let header: StrapiHeader | undefined;
let footer: StrapiFooter | undefined;

try {
  [header, footer] = await Promise.all([getHeader(), getFooter()]);
} catch {
  // CMS unavailable — render without nav
}
---

<BaseLayout {seo} {global} {jsonLd} {noindex}>
  <slot name="head" slot="head" />

  <Header {header} {global} menuId="main-menu" />
  <SlashMenu {header} {global} id="main-menu" />

  <main id="main-content" style="padding-top:80px;">
    <slot />
  </main>

  <Footer {footer} {global} />
</BaseLayout>

<style>@import '../styles/components/twh-page-transition.css';</style>

<script>
  import { initMenu } from '../scripts/interactions/menu';
  import { initPageTransition } from '../scripts/transitions/page-transition';
  initMenu();
  initPageTransition();
</script>
