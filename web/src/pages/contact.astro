---
import PageLayout from '../layouts/PageLayout.astro';
import { getGlobal } from '../lib/strapi/queries';
import type { StrapiGlobal } from '../lib/strapi/types';

let global: StrapiGlobal | undefined;
try { global = await getGlobal(); } catch { /* CMS offline */ }

const phone    = global?.phone    ?? '+94 11 234 5678';
const email    = global?.email    ?? 'hello@thewolverinehub.com';
const address  = global?.address  ?? '42 Braybrooke Place, Colombo 02, Sri Lanka';
const whatsapp = global?.whatsapp ?? phone;
const hours    = global?.hoursJson ?? {
  'Monday – Friday':  '06:00 AM – 10:00 PM',
  Saturday:           '07:00 AM – 08:00 PM',
  Sunday:             '08:00 AM – 06:00 PM',
};

const seo = {
  metaTitle: 'Contact — The Wolverine Hub',
  metaDescription: 'Get in touch, book a free trial, or ask us anything. We\'re in Colombo, Sri Lanka.',
};
---

<PageLayout {seo} {global}>
  <!-- Page hero -->
  <div class="twh-page-hero">
    <div class="twh-page-hero__inner">
      <p class="twh-page-hero__eyebrow">Get In Touch</p>
      <h1 class="twh-page-hero__heading">Start Here.</h1>
      <p class="twh-page-hero__sub">Questions, free trial bookings, or just want to know if this place is right for you — send us a message.</p>
    </div>
  </div>

  <section class="twh-contact" aria-label="Contact us">
    <div class="twh-contact__inner">

      <!-- Contact info -->
      <div class="twh-contact__info" id="contact-info">
        <h2 class="twh-contact__info-heading">Find Us.</h2>
        <p class="twh-contact__info-sub">We're in the heart of Colombo. Walk-ins welcome during opening hours — or reach out ahead of time.</p>

        <div class="twh-contact__details">
          <div class="twh-contact__detail-item">
            <span class="twh-contact__detail-slash" aria-hidden="true">/</span>
            <div class="twh-contact__detail-content">
              <p class="twh-contact__detail-label">Address</p>
              <p class="twh-contact__detail-value">{address}</p>
            </div>
          </div>
          <div class="twh-contact__detail-item">
            <span class="twh-contact__detail-slash" aria-hidden="true">/</span>
            <div class="twh-contact__detail-content">
              <p class="twh-contact__detail-label">Phone</p>
              <a href={`tel:${phone.replace(/\s/g,'')}`} class="twh-contact__detail-value">{phone}</a>
            </div>
          </div>
          <div class="twh-contact__detail-item">
            <span class="twh-contact__detail-slash" aria-hidden="true">/</span>
            <div class="twh-contact__detail-content">
              <p class="twh-contact__detail-label">WhatsApp</p>
              <a href={`https://wa.me/${whatsapp.replace(/\D/g,'')}`} target="_blank" rel="noopener noreferrer" class="twh-contact__detail-value">Message us</a>
            </div>
          </div>
          <div class="twh-contact__detail-item">
            <span class="twh-contact__detail-slash" aria-hidden="true">/</span>
            <div class="twh-contact__detail-content">
              <p class="twh-contact__detail-label">Email</p>
              <a href={`mailto:${email}`} class="twh-contact__detail-value">{email}</a>
            </div>
          </div>
        </div>

        <!-- Hours -->
        <div class="twh-contact__hours">
          <p class="twh-contact__hours-heading">Opening Hours</p>
          <div class="twh-contact__hours-grid">
            {Object.entries(hours).map(([day, time]) => (
              <div class="twh-contact__hours-row">
                <span class="twh-contact__hours-day">{day}</span>
                <span class="twh-contact__hours-time">{time}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="twh-contact__form-wrap" id="contact-form-wrap">
        <form class="twh-contact__form" id="contact-form" novalidate>
          <div>
            <h2 class="twh-contact__form-heading">Send a Message.</h2>
            <p class="twh-contact__form-sub">We reply within 24 hours on business days.</p>
          </div>

          <div class="twh-contact__field">
            <label class="twh-contact__label" for="cf-name">
              Name <span class="twh-contact__label-required" aria-label="required">*</span>
            </label>
            <input class="twh-contact__input" id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Your full name" />
          </div>

          <div class="twh-contact__field">
            <label class="twh-contact__label" for="cf-email">
              Email <span class="twh-contact__label-required" aria-label="required">*</span>
            </label>
            <input class="twh-contact__input" id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
          </div>

          <div class="twh-contact__field">
            <label class="twh-contact__label" for="cf-phone">Phone</label>
            <input class="twh-contact__input" id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder="+94 77 000 0000" />
          </div>

          <div class="twh-contact__field">
            <label class="twh-contact__label" for="cf-message">Message</label>
            <textarea class="twh-contact__textarea" id="cf-message" name="message" rows="4" placeholder="Tell us what you're looking for…"></textarea>
          </div>

          <!-- Honeypot -->
          <div class="twh-contact__honeypot" aria-hidden="true">
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div id="contact-status" class="twh-contact__status" role="alert" aria-live="polite"></div>

          <button class="twh-btn twh-btn--primary twh-btn--md twh-contact__submit" type="submit">
            Send Message
          </button>
        </form>
      </div>

    </div>
  </section>
</PageLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Entrance animations ────────────────────────────────────────
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector('.twh-page-hero__inner');
    if (hero) {
      const tl = gsap.timeline();
      const eyebrow = hero.querySelector('.twh-page-hero__eyebrow');
      const heading = hero.querySelector('.twh-page-hero__heading');
      const sub     = hero.querySelector('.twh-page-hero__sub');
      if (eyebrow) tl.fromTo(eyebrow, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' });
      if (heading) tl.fromTo(heading, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.25');
      if (sub)     tl.fromTo(sub,     { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.3');
    }

    const info = document.getElementById('contact-info');
    const form = document.getElementById('contact-form-wrap');
    if (info) gsap.fromTo(info, { x: -30, opacity: 0 }, { x: 0, opacity: 1, duration: 0.7, ease: 'power3.out', scrollTrigger: { trigger: info, start: 'top 85%' } });
    if (form) gsap.fromTo(form, { x:  30, opacity: 0 }, { x: 0, opacity: 1, duration: 0.7, ease: 'power3.out', scrollTrigger: { trigger: form, start: 'top 85%' } });
  });

  gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
    ['contact-info','contact-form-wrap'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.opacity = '1';
    });
  });

  // ── Form submission ────────────────────────────────────────────
  const form   = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status')!;
  const submit = form?.querySelector<HTMLButtonElement>('[type="submit"]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Honeypot check
    const honeypot = form.querySelector<HTMLInputElement>('[name="website"]');
    if (honeypot?.value) return;

    const data = new FormData(form);
    const name    = (data.get('name')    as string).trim();
    const email   = (data.get('email')   as string).trim();
    const phone   = (data.get('phone')   as string).trim();
    const message = (data.get('message') as string).trim();

    if (!name || !email) {
      showStatus('error', 'Please fill in your name and email.');
      return;
    }

    if (submit) { submit.disabled = true; submit.textContent = 'Sending…'; }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, phone, message }),
      });

      if (res.ok) {
        showStatus('success', "Message sent — we'll be in touch within 24 hours.");
        form.reset();
      } else {
        const json = await res.json().catch(() => ({}));
        showStatus('error', json.message ?? 'Something went wrong. Please try again.');
      }
    } catch {
      showStatus('error', 'Network error. Please check your connection and try again.');
    } finally {
      if (submit) { submit.disabled = false; submit.textContent = 'Send Message'; }
    }
  });

  function showStatus(state: 'success' | 'error', msg: string) {
    status.dataset.state = state;
    status.textContent   = msg;
    status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>
