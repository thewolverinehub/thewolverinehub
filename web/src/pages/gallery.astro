---
/**
 * Gallery — spotlight bento of featured shots, sticky filter toolbar (category chips with counts,
 * mosaic / grid toggle), hover overlays, "show more", and the shared lightbox (only the visible
 * filter is stepped through). Photos come from the "Gallery Items" collection in Strapi.
 */
import PageLayout from '../layouts/PageLayout.astro';
import WolverineSlash from '../components/ui/WolverineSlash.astro';
import Lightbox from '../components/ui/Lightbox.astro';
import { getGlobal, getGalleryItems, getPageBySlug } from '../lib/strapi/queries';
import type { StrapiGalleryItem, StrapiPageHeroSection } from '../lib/strapi/types';

let global, items: StrapiGalleryItem[] = [], pageData: Awaited<ReturnType<typeof getPageBySlug>> = null;
try {
  [global, items, pageData] = await Promise.all([getGlobal(), getGalleryItems(), getPageBySlug('gallery')]);
} catch { /* CMS offline */ }

const pageHero = pageData?.sections?.find((s) => s.__component === 'sections.page-hero') as StrapiPageHeroSection | undefined;

const CMS = import.meta.env.CMS_PUBLIC_URL ?? 'https://cms-production-3644.up.railway.app';
const abs = (u?: string) => (u ? (u.startsWith('http') ? u : `${CMS}${u}`) : '');
const thumb = (m: StrapiGalleryItem['media']) => abs(m?.formats?.medium?.url ?? m?.formats?.small?.url ?? m?.url);

const photos = items.filter((i) => i.media?.url);
const label = (c?: string) => (c ? c.charAt(0).toUpperCase() + c.slice(1) : 'General');
const cats = [...new Set(photos.map((p) => p.category ?? 'general'))].map((c) => ({ key: c, name: label(c), count: photos.filter((p) => (p.category ?? 'general') === c).length }));
const spotlight = photos.filter((p) => p.isFeatured).slice(0, 3);
const INITIAL = 12;

const igUrl = global?.instagram ?? 'https://instagram.com/thewolverinehub';
const seo = {
  metaTitle: 'Gallery — The Wolverine Hub',
  metaDescription: 'Inside The Wolverine Hub. Real training. Real athletes. No poses, no filters.',
};
---

<PageLayout {seo} {global}>
  <!-- ═════════ Hero ═════════ -->
  <section class="twh-gl-hero">
    <div class="twh-gl-hero__bg" aria-hidden="true">
      <WolverineSlash class="twh-gl-hero__slash twh-gl-hero__slash--a" />
      <WolverineSlash class="twh-gl-hero__slash twh-gl-hero__slash--b" />
    </div>
    <div class="twh-gl-wrap twh-gl-hero__inner">
      <p class="twh-gl-eyebrow"><span aria-hidden="true">/</span> {pageHero?.eyebrow ?? 'Gallery'}</p>
      <h1 class="twh-gl-hero__title" set:html={pageHero ? pageHero.heading.replace(/\n/g, '<br/>') : 'Inside<br/>The Hub.'} />
      <p class="twh-gl-hero__sub">{pageHero?.subheading ?? 'Real training. Real athletes. No poses, no filters.'}</p>
      <ul class="twh-gl-hero__stats" role="list">
        <li><b>{photos.length}</b> photos</li>
        <li><b>{cats.length}</b> categories</li>
        <li><a href={igUrl} target="_blank" rel="noopener noreferrer">More on Instagram →</a></li>
      </ul>
    </div>
  </section>

  {photos.length === 0 ? (
    <section class="twh-gl-wrap twh-gl-empty">
      <div class="twh-gl-empty__grid" aria-hidden="true">{Array.from({ length: 6 }).map(() => <span><i>/</i></span>)}</div>
      <p>Photos are coming soon. Follow us on Instagram for daily updates.</p>
      <a href={igUrl} class="twh-btn twh-btn--ghost twh-btn--md" target="_blank" rel="noopener noreferrer">@thewolverinehub</a>
    </section>
  ) : (
    <>
      <!-- ═════════ Spotlight ═════════ -->
      {spotlight.length > 0 && (
        <section class="twh-gl-spot" aria-labelledby="gl-spot-h">
          <div class="twh-gl-wrap">
            <h2 class="twh-gl-h2" id="gl-spot-h"><span aria-hidden="true">/</span> Spotlight</h2>
            <div class={`twh-gl-bento twh-gl-bento--${spotlight.length}`}>
              {spotlight.map((p, i) => (
                <a href={abs(p.media.url)} class="twh-gl-bento__tile" data-lightbox="gallery" data-caption={p.caption ?? p.alt} style={`--i:${i}`}>
                  <img src={thumb(p.media)} alt={p.alt ?? p.caption ?? ''} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width={p.media.width ?? 1200} height={p.media.height ?? 800} />
                  <span class="twh-gl-bento__shade" aria-hidden="true"></span>
                  <span class="twh-gl-bento__meta"><em>{label(p.category)}</em><b>{p.caption ?? p.alt}</b></span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- ═════════ Toolbar ═════════ -->
      <div class="twh-gl-toolbar" id="gl-toolbar">
        <div class="twh-gl-wrap twh-gl-toolbar__inner">
          <div class="twh-gl-chips" role="group" aria-label="Filter by category">
            <button type="button" class="twh-gl-chip" data-cat="all" aria-pressed="true">All <span>{photos.length}</span></button>
            {cats.map((c) => <button type="button" class="twh-gl-chip" data-cat={c.key} aria-pressed="false">{c.name} <span>{c.count}</span></button>)}
          </div>
          <div class="twh-gl-view" role="group" aria-label="Layout">
            <button type="button" class="twh-gl-view__btn" data-view="mosaic" aria-pressed="true" aria-label="Mosaic layout" title="Mosaic">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="11" rx="1"/><rect x="13" y="3" width="8" height="6" rx="1"/><rect x="13" y="11" width="8" height="10" rx="1"/><rect x="3" y="16" width="8" height="5" rx="1"/></svg>
            </button>
            <button type="button" class="twh-gl-view__btn" data-view="grid" aria-pressed="false" aria-label="Grid layout" title="Grid">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- ═════════ Photos ═════════ -->
      <section class="twh-gl-main" aria-label="Photos">
        <div class="twh-gl-wrap">
          <p class="twh-gl-count" id="gl-count" aria-live="polite">Showing {Math.min(INITIAL, photos.length)} of {photos.length}</p>
          <ul class="twh-gl-grid" id="gl-grid" data-view="mosaic" data-initial={INITIAL} role="list">
            {photos.map((p, i) => (
              <li class="twh-gl-item" data-cat={p.category ?? 'general'} style={`--ratio:${(p.media.width ?? 4) / (p.media.height ?? 3)}`}>
                <a href={abs(p.media.url)} class="twh-gl-tile" data-lightbox="gallery" data-caption={p.caption ?? p.alt} aria-label={`View photo: ${p.caption ?? p.alt}`}>
                  <img src={thumb(p.media)} alt={p.alt ?? p.caption ?? ''} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" width={p.media.width ?? 1200} height={p.media.height ?? 800} />
                  <span class="twh-gl-tile__shade" aria-hidden="true"></span>
                  <span class="twh-gl-tile__tag">{label(p.category)}</span>
                  {p.isFeatured && <span class="twh-gl-tile__star" aria-label="Featured">★</span>}
                  <span class="twh-gl-tile__cap">{p.caption ?? p.alt}</span>
                  <span class="twh-gl-tile__zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></span>
                </a>
              </li>
            ))}
          </ul>
          <div class="twh-gl-more"><button type="button" class="twh-btn twh-btn--ghost twh-btn--lg" id="gl-more" hidden>Show more photos</button></div>
        </div>
      </section>
    </>
  )}

  <!-- ═════════ Follow ═════════ -->
  <section class="twh-gl-follow">
    <div class="twh-gl-wrap twh-gl-follow__inner">
      <div>
        <p class="twh-gl-eyebrow"><span aria-hidden="true">/</span> Follow along</p>
        <h2 class="twh-gl-follow__title">Daily training. Daily stories.</h2>
      </div>
      <a href={igUrl} class="twh-btn twh-btn--primary twh-btn--lg" target="_blank" rel="noopener noreferrer">Follow @thewolverinehub</a>
    </div>
  </section>

  <Lightbox />
</PageLayout>

<style is:global>@import '../styles/pages/twh-gallery.css';</style>

<script>
  import { initGallery } from '../scripts/interactions/gallery';
  initGallery();
</script>
