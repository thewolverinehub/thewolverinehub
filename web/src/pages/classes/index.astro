---
import PageLayout from '../../layouts/PageLayout.astro';
import { getClasses, getGlobal, getPageBySlug } from '../../lib/strapi/queries';
import type { StrapiClass, StrapiPageHeroSection } from '../../lib/strapi/types';

let global, classes: StrapiClass[] = [], pageData: Awaited<ReturnType<typeof getPageBySlug>> = null;
try {
  [global, classes, pageData] = await Promise.all([getGlobal(), getClasses(), getPageBySlug('classes')]);
} catch { /* CMS offline */ }

const pageHero = pageData?.sections?.find(s => s.__component === 'sections.page-hero') as StrapiPageHeroSection | undefined;

const fallback: StrapiClass[] = [
  { documentId: '1', name: 'Boxing',               slug: 'boxing',               tagline: 'The sweet science',        durationMinutes: 60, intensity: 'high',    level: 'all',          isFree: false, sortOrder: 1 },
  { documentId: '2', name: 'Muay Thai',            slug: 'muay-thai',            tagline: 'Eight limbs',              durationMinutes: 90, intensity: 'high',    level: 'intermediate', isFree: false, sortOrder: 2 },
  { documentId: '3', name: 'BJJ',                  slug: 'bjj',                  tagline: 'Ground game',              durationMinutes: 90, intensity: 'medium',  level: 'all',          isFree: false, sortOrder: 3 },
  { documentId: '4', name: 'Kickboxing',           slug: 'kickboxing',           tagline: 'Power & precision',        durationMinutes: 60, intensity: 'high',    level: 'all',          isFree: false, sortOrder: 4 },
  { documentId: '5', name: 'Strength & Conditioning', slug: 'strength-conditioning', tagline: 'Build the base',       durationMinutes: 60, intensity: 'medium',  level: 'all',          isFree: false, sortOrder: 5 },
  { documentId: '6', name: 'Wrestling',            slug: 'wrestling',            tagline: 'Control the mat',          durationMinutes: 75, intensity: 'extreme', level: 'advanced',     isFree: false, sortOrder: 6 },
  { documentId: '7', name: 'MMA',                  slug: 'mma',                  tagline: 'The complete fighter',     durationMinutes: 90, intensity: 'extreme', level: 'advanced',     isFree: false, sortOrder: 7 },
  { documentId: '8', name: 'Yoga',                 slug: 'yoga',                 tagline: 'Recovery & mobility',      durationMinutes: 60, intensity: 'low',     level: 'all',          isFree: false, sortOrder: 8 },
];

const display = classes.length > 0 ? classes : fallback;

const intensityColour: Record<string, string> = {
  low:     'var(--color-twh-blue)',
  medium:  'var(--color-twh-yellow)',
  high:    'var(--color-twh-red)',
  extreme: 'var(--color-twh-red-deep)',
};

const intensityText: Record<string, string> = {
  low: 'var(--color-twh-white)',
  medium: 'var(--color-twh-black)',
  high: 'var(--color-twh-white)',
  extreme: 'var(--color-twh-white)',
};

const levels = [...new Set(display.map(c => c.level))].sort();
const intensities = [...new Set(display.map(c => c.intensity))];

const seo = {
  metaTitle: 'Classes — The Wolverine Hub',
  metaDescription: 'Explore every discipline — Boxing, Muay Thai, BJJ, MMA, Strength & more. Find the class that fits your level.',
};
---

<PageLayout {seo} {global}>
  <!-- Page Hero -->
  <div class="twh-page-hero">
    <div class="twh-page-hero__inner">
      <p class="twh-page-hero__eyebrow">{pageHero?.eyebrow ?? 'Train'}</p>
      <h1 class="twh-page-hero__heading" set:html={pageHero ? pageHero.heading.replace(/\n/g, '<br/>') : 'Every Discipline.<br/>Every Level.'} />
      <p class="twh-page-hero__sub">{pageHero?.subheading ?? 'From your first session to your hundredth fight — we have a class built for where you are right now.'}</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="twh-classes__filters" role="navigation" aria-label="Filter classes">
    <div class="twh-classes__filters-inner">
      <button class="twh-classes__filter-btn" data-filter="all" aria-pressed="true">All</button>
      {levels.map(l => (
        <button class="twh-classes__filter-btn" data-filter={`level:${l}`} aria-pressed="false">
          {l}
        </button>
      ))}
      <span aria-hidden="true" style="width:1px;height:20px;background:var(--color-twh-grey-800);flex-shrink:0;margin:0 0.25rem;"></span>
      {intensities.map(i => (
        <button class="twh-classes__filter-btn" data-filter={`intensity:${i}`} aria-pressed="false">
          {i}
        </button>
      ))}
    </div>
  </div>

  <!-- Grid -->
  <section class="twh-classes__grid-section" aria-label="Classes">
    <div class="twh-inner">
      <ul class="twh-classes__grid" role="list" id="classes-grid">
        {display.map((cls) => {
          const bg  = intensityColour[cls.intensity] ?? 'var(--color-twh-grey-700)';
          const txt = intensityText[cls.intensity]   ?? 'var(--color-twh-white)';
          return (
            <li
              class="twh-classes__card"
              data-level={cls.level}
              data-intensity={cls.intensity}
            >
              <a href={`/classes/${cls.slug}`} class="twh-classes__card-link">
                <div class="twh-classes__card-media">
                  {cls.thumbnail ? (
                    <img src={cls.thumbnail.url} alt={cls.thumbnail.alternativeText ?? cls.name} loading="lazy" />
                  ) : (
                    <div class="twh-classes__card-placeholder" style={`background: linear-gradient(135deg, ${bg}22 0%, transparent 80%), var(--color-twh-grey-900);`}>
                      <span class="twh-classes__card-placeholder-slash" aria-hidden="true">/</span>
                    </div>
                  )}
                  <span class="twh-classes__card-badge" style={`background:${bg}; color:${txt};`}>
                    {cls.intensity}
                  </span>
                </div>
                <div class="twh-classes__card-body">
                  <h2 class="twh-classes__card-name">{cls.name}</h2>
                  {cls.tagline && <p class="twh-classes__card-tagline">{cls.tagline}</p>}
                  <div class="twh-classes__card-meta">
                    <span>{cls.durationMinutes} min</span>
                    <span>{cls.level}</span>
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="twh-classes__empty" id="no-results" style="display:none;">No classes match that filter.</p>
    </div>
  </section>
</PageLayout>

<style>@import '../../styles/pages/twh-classes.css';</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Filter logic ───────────────────────────────────────────────
  const btns  = document.querySelectorAll<HTMLButtonElement>('.twh-classes__filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.twh-classes__card');
  const noRes = document.getElementById('no-results')!;

  function applyFilter(filter: string) {
    btns.forEach(b => b.setAttribute('aria-pressed', b.dataset.filter === filter ? 'true' : 'false'));
    let visible = 0;
    cards.forEach(card => {
      let show = filter === 'all';
      if (!show && filter.startsWith('level:'))     show = card.dataset.level     === filter.replace('level:', '');
      if (!show && filter.startsWith('intensity:')) show = card.dataset.intensity === filter.replace('intensity:', '');
      card.dataset.hidden = show ? 'false' : 'true';
      if (show) visible++;
    });
    noRes.style.display = visible === 0 ? 'block' : 'none';
  }

  btns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
  });

  // ── Entrance animations ────────────────────────────────────────
  const hero = document.querySelector('.twh-page-hero__inner');
  if (hero) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const eyebrow = hero.querySelector('.twh-page-hero__eyebrow');
      const heading = hero.querySelector('.twh-page-hero__heading');
      const sub     = hero.querySelector('.twh-page-hero__sub');
      const tl = gsap.timeline();
      if (eyebrow) tl.fromTo(eyebrow, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' });
      if (heading) tl.fromTo(heading, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.25');
      if (sub)     tl.fromTo(sub,     { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.3');
    });
  }

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.fromTo(cards,
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.55, stagger: 0.07, ease: 'power3.out',
        scrollTrigger: { trigger: '#classes-grid', start: 'top 85%' } }
    );
  });

  gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
    cards.forEach(el => { el.style.opacity = '1'; });
  });
</script>
