---
import PageLayout from '../../layouts/PageLayout.astro';
import { getClasses, getGlobal, getPageBySlug, getScheduleSlots } from '../../lib/strapi/queries';
import { DAYS, formatLKR, type Day } from '../../lib/utils/colombo';
import type { StrapiClass, StrapiPageHeroSection, StrapiScheduleSlot } from '../../lib/strapi/types';
import WolverineSlash from '../../components/ui/WolverineSlash.astro';

let global: Awaited<ReturnType<typeof getGlobal>> | undefined;
let classes: StrapiClass[] = [];
let pageData: Awaited<ReturnType<typeof getPageBySlug>> = null;
let slots: StrapiScheduleSlot[] = [];
try {
  [global, classes, pageData, slots] = await Promise.all([getGlobal(), getClasses(), getPageBySlug('classes'), getScheduleSlots()]);
} catch { /* CMS offline */ }

const pageHero = pageData?.sections?.find(
  s => s.__component === 'sections.page-hero'
) as StrapiPageHeroSection | undefined;

const fallback: StrapiClass[] = [
  { documentId: '1', name: 'Colossus',      slug: 'colossus',       tagline: 'Strength Training', durationMinutes: 75, intensity: 'high',    level: 'all', price: 3000, isFree: false, sortOrder: 1 },
  { documentId: '2', name: 'Pop Pop Bang',  slug: 'pop-pop-bang',   tagline: 'Boxing',            durationMinutes: 75, intensity: 'high',    level: 'all', price: 3000, isFree: false, sortOrder: 2 },
  { documentId: '3', name: "Titan's Den",   slug: 'titans-den',     tagline: 'MMA',               durationMinutes: 90, intensity: 'extreme', level: 'all', price: 3000, isFree: false, sortOrder: 3 },
  { documentId: '4', name: 'Makkari',       slug: 'makkari',        tagline: 'Easy Run',          durationMinutes: 60, intensity: 'low',     level: 'all', price: 0,    isFree: true,  sortOrder: 4 },
];

const display = classes.length > 0 ? classes : fallback;

// Which weekdays each class runs (from its weekly slots) — drives the Day filter + the card line
const daysByClass = new Map<string, Day[]>();
for (const sl of slots) {
  const k = sl.class?.slug;
  if (!k) continue;
  const list = daysByClass.get(k) ?? [];
  if (!list.includes(sl.weekday as Day)) list.push(sl.weekday as Day);
  daysByClass.set(k, list);
}
const daysOf = (slug: string) => (daysByClass.get(slug) ?? []).sort((x, y) => DAYS.indexOf(x) - DAYS.indexOf(y));
const dayShort = (d: string) => d.charAt(0).toUpperCase() + d.slice(1, 3);
const daysLine = (days: Day[]) => (days.length === 5 && days.every((d, i) => d === DAYS[i]) ? 'Mon – Fri' : days.map(dayShort).join(' · '));

// Card text limits (also enforced in the Strapi schema) — clip defensively so long
// content can never break the card layout.
const TITLE_MAX = 20;
const DESC_MAX  = 50;
const clip = (text: string, max: number) =>
  text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text;

const intensityColour: Record<string, string> = {
  low:     'var(--color-twh-blue)',
  medium:  'var(--color-twh-yellow)',
  high:    'var(--color-twh-red)',
  extreme: 'var(--color-twh-red-deep)',
};

const intensityTextColour: Record<string, string> = {
  low:     'var(--color-twh-white)',
  medium:  'var(--color-twh-black)',
  high:    'var(--color-twh-white)',
  extreme: 'var(--color-twh-white)',
};

// Filter groups — "All" is frontend-only. Day and price combine (AND).
const DAY_NAMES: Record<Day, string> = { monday: 'Mon', tuesday: 'Tue', wednesday: 'Wed', thursday: 'Thu', friday: 'Fri', saturday: 'Sat', sunday: 'Sun' };
const FILTER_GROUPS = [
  { key: 'day', label: 'Day', options: DAYS.map((d) => ({ label: DAY_NAMES[d], value: d, accent: 'var(--color-twh-yellow)', ink: 'var(--color-twh-black)' })) },
  { key: 'price', label: 'Price', options: [
    { label: 'Free', value: 'free', accent: 'var(--color-twh-blue)', ink: 'var(--color-twh-white)' },
    { label: 'Paid', value: 'paid', accent: 'var(--color-twh-red)',  ink: 'var(--color-twh-white)' },
  ]},
];

const seo = {
  metaTitle: 'Classes — The Wolverine Hub',
  metaDescription: 'Strength, boxing, MMA, hybrid training, yoga and more — book the classes you want and pay per session.',
};
---

<PageLayout {seo} {global}>

  <!-- Page Hero -->
  <div class="twh-page-hero">
    <div class="twh-page-hero__inner">
      <p class="twh-page-hero__eyebrow">{pageHero?.eyebrow ?? 'Train'}</p>
      <h1
        class="twh-page-hero__heading"
        set:html={pageHero
          ? pageHero.heading.replace(/\n/g, '<br/>')
          : 'One Class.<br/>One Booking.'}
      />
      <p class="twh-page-hero__sub">
        {pageHero?.subheading ?? 'No memberships. Pick the class you want, book your slot and pay for that session only.'}
      </p>
    </div>
  </div>

  <!-- Filter bar -->
  <nav class="twh-classes__filters" aria-label="Filter classes">
    <div class="twh-classes__filters-inner">
      <button
        class="twh-classes__filter-btn"
        data-filter-group="all"
        data-filter="all"
        aria-pressed="true"
        style="--btn-accent: var(--color-twh-white); --btn-ink: var(--color-twh-black);"
      >
        All
      </button>
      {FILTER_GROUPS.map((group) => (
        <div class="twh-classes__filter-group" role="group" aria-label={group.label}>
          <span class="twh-classes__filter-group-label">{group.label}</span>
          {group.options.map((o) => (
            <button
              class="twh-classes__filter-btn"
              data-filter-group={group.key}
              data-filter={o.value}
              aria-pressed="false"
              style={`--btn-accent: ${o.accent}; --btn-ink: ${o.ink};`}
            >
              {o.label}
            </button>
          ))}
        </div>
      ))}
    </div>
  </nav>

  <!-- Classes grid -->
  <section class="twh-classes__section" aria-label="Classes">

    <div class="twh-classes__inner">
      <ul class="twh-classes__grid" role="list" id="classes-grid">
        {display.map((cls) => {
          const hasVideo = Boolean(cls.previewVideo?.url);
          const accent  = intensityColour[cls.intensity]     ?? 'var(--color-twh-grey-700)';
          const txtClr  = intensityTextColour[cls.intensity] ?? 'var(--color-twh-white)';
          const days = daysOf(cls.slug);
          const isFree = (cls.price ?? 0) === 0 || cls.isFree;
          const priceText = isFree ? 'Free' : formatLKR(cls.price);
          return (
            <li
              class="twh-classes__card"
              style={`--card-accent: ${accent};`}
              data-days={days.join(',')}
              data-price={isFree ? 'free' : 'paid'}
              data-has-video={hasVideo}
            >
              <a
                href={`/classes/${cls.slug}`}
                class="twh-classes__card-link"
                aria-label={`${cls.name}${cls.tagline ? ` — ${cls.tagline}` : ''}, ${priceText}${isFree ? '' : ' per session'}${days.length ? `, ${daysLine(days)}` : ''}`}
              >

                <!-- Left intensity stripe -->
                <span class="twh-classes__card-stripe" aria-hidden="true"></span>

                <!-- Full-bleed media -->
                <div class="twh-classes__card-media">
                  {cls.thumbnail ? (
                    <img
                      src={cls.thumbnail.url}
                      alt={cls.thumbnail.alternativeText ?? cls.name}
                      loading="lazy"
                    />
                  ) : (
                    <div class="twh-classes__card-placeholder" aria-hidden="true">
                      <WolverineSlash class="twh-classes__card-ph-slash" />
                    </div>
                  )}
                  {hasVideo && (
                    <video
                      class="twh-classes__card-video"
                      src={cls.previewVideo!.url}
                      poster={cls.thumbnail?.url}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                    />
                  )}
                  <div class="twh-classes__card-overlay" aria-hidden="true"></div>
                </div>

                <!-- Intensity badge -->
                <span
                  class="twh-classes__card-badge"
                  style={`background: ${accent}; color: ${txtClr};`}
                >
                  {cls.intensity}
                </span>

                {hasVideo && (
                  <span class="twh-classes__card-playhint" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 14 14" fill="currentColor"><path d="M3 2l9 5-9 5V2z"/></svg>
                    Hover to preview
                  </span>
                )}

                <!-- Overlaid content -->
                <div class="twh-classes__card-content">
                  <h2 class="twh-classes__card-name" title={cls.name.length > TITLE_MAX ? cls.name : undefined}>{clip(cls.name, TITLE_MAX)}</h2>
                  {cls.tagline && (
                    <p class="twh-classes__card-tagline" title={cls.tagline.length > DESC_MAX ? cls.tagline : undefined}>{clip(cls.tagline, DESC_MAX)}</p>
                  )}
                  <div class="twh-classes__card-foot">
                    <div class="twh-classes__card-meta">
                      <span>{cls.durationMinutes >= 240 ? 'Day pass' : `${cls.durationMinutes} min`}</span>
                      {days.length > 0 && <span class="twh-classes__card-meta-dot" aria-hidden="true"></span>}
                      {days.length > 0 && <span>{daysLine(days)}</span>}
                    </div>
                    <span class={`twh-classes__card-price${isFree ? ' is-free' : ''}`}>{isFree ? 'FREE' : priceText}</span>
                  </div>
                </div>

              </a>
            </li>
          );
        })}
      </ul>

      <div class="twh-classes__empty" id="no-results" style="display:none;" aria-live="polite">
        <WolverineSlash class="twh-classes__empty-icon" aria-hidden="true" />
        <p class="twh-classes__empty-heading">No Classes at the Moment</p>
        <p class="twh-classes__empty-sub" id="no-results-sub">No classes match those filters. Try another day or <a href="/schedule">see the full schedule</a>.</p>
      </div>
    </div>
  </section>

</PageLayout>

<style is:global>@import '../../styles/pages/twh-classes.css';</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Filter ──────────────────────────────────────────────────
  // Day and price are independent groups, combined with AND.
  // Clicking the active option again (or "All") clears that selection.
  const btns  = document.querySelectorAll<HTMLButtonElement>('.twh-classes__filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.twh-classes__card');
  const noRes = document.getElementById('no-results')!;
  const state: Record<string, string> = { day: 'all', price: 'all' };

  function applyFilter() {
    const none = state.day === 'all' && state.price === 'all';
    btns.forEach(b => {
      const group = b.dataset.filterGroup!;
      const on = group === 'all' ? none : state[group] === b.dataset.filter;
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });

    let visible = 0;
    cards.forEach(card => {
      const show =
        (state.day === 'all'   || (card.dataset.days ?? '').split(',').includes(state.day)) &&
        (state.price === 'all' || card.dataset.price === state.price);
      card.classList.toggle('is-filtered-out', !show);
      if (show) {
        visible++;
        // Entrance tween may not have run yet for cards that were off-screen.
        gsap.set(card, { clearProps: 'transform', opacity: 1 });
      }
    });
    noRes.style.display = visible === 0 ? 'flex' : 'none';
  }

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.filterGroup!;
      if (group === 'all') {
        state.day = 'all';
        state.price = 'all';
      } else {
        state[group] = state[group] === btn.dataset.filter ? 'all' : btn.dataset.filter!;
      }
      applyFilter();
    });
  });

  // ── Card hover video (mouse + keyboard focus; not on touch, not with reduced motion) ──
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canHover && !reduced) {
    cards.forEach(card => {
      if (card.dataset.hasVideo !== 'true') return;
      const video = card.querySelector<HTMLVideoElement>('.twh-classes__card-video');
      if (!video) return;
      const start = () => {
        card.classList.add('is-playing');
        video.play().catch(() => { card.classList.remove('is-playing'); });
      };
      const stop = () => {
        card.classList.remove('is-playing');
        video.pause();
        video.currentTime = 0;
      };
      card.addEventListener('mouseenter', start);
      card.addEventListener('mouseleave', stop);
      card.addEventListener('focusin', start);
      card.addEventListener('focusout', stop);
    });
  }

  // ── Hero entrance ──────────────────────────────────────────
  const hero = document.querySelector('.twh-page-hero__inner');
  if (hero) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline();
      const eyebrow = hero.querySelector('.twh-page-hero__eyebrow');
      const heading = hero.querySelector('.twh-page-hero__heading');
      const sub     = hero.querySelector('.twh-page-hero__sub');
      if (eyebrow) tl.fromTo(eyebrow, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' });
      if (heading) tl.fromTo(heading, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.25');
      if (sub)     tl.fromTo(sub,     { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.3');
    });
  }

  // ── Cards entrance ─────────────────────────────────────────
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.fromTo(cards,
      { y: 50, opacity: 0 },
      {
        y: 0, opacity: 1, duration: 0.7, stagger: { each: 0.07, from: 'start' },
        ease: 'power3.out',
        scrollTrigger: { trigger: '#classes-grid', start: 'top 88%' }
      }
    );
  });

  gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
    cards.forEach(el => { el.style.opacity = '1'; });
  });
</script>
