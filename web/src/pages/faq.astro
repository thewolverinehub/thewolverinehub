---
/**
 * FAQ — live search (with highlighting), category rail with counts, deep links (#question-id),
 * expand / collapse all, and a "still need help?" hand-off. Questions come from Strapi.
 */
import PageLayout from '../layouts/PageLayout.astro';
import WolverineSlash from '../components/ui/WolverineSlash.astro';
import { getGlobal, getFaqs, getFaqCategories, getPageBySlug } from '../lib/strapi/queries';
import { blocksToHtml } from '../lib/strapi/blocks';
import { faqSchema } from '../lib/seo/json-ld';
import type { StrapiFaq, StrapiFaqCategory, StrapiPageHeroSection } from '../lib/strapi/types';

let global, faqs: StrapiFaq[] = [], categories: StrapiFaqCategory[] = [], pageData: Awaited<ReturnType<typeof getPageBySlug>> = null;
try {
  [global, faqs, categories, pageData] = await Promise.all([getGlobal(), getFaqs(), getFaqCategories(), getPageBySlug('faq')]);
} catch { /* CMS offline */ }

const pageHero = pageData?.sections?.find((s) => s.__component === 'sections.page-hero') as StrapiPageHeroSection | undefined;

const para = (text: string) => [{ type: 'paragraph', children: [{ type: 'text', text }] }];
const fallbackFaqs: StrapiFaq[] = [
  { documentId: 'f1', question: 'Do I need experience to join?', answer: para('No experience needed. Every class has coaches who scale the session to your level.'), isFeatured: true, sortOrder: 1 },
  { documentId: 'f2', question: 'How does paying per class work?', answer: para('Each class has its own price per session. Pick a session, pay online, and your spot is confirmed — there is no membership or lock-in.'), isFeatured: true, sortOrder: 2 },
  { documentId: 'f3', question: 'Can I cancel a booking?', answer: para('Yes. Cancel at least 12 hours before the session starts and you are refunded in full.'), isFeatured: true, sortOrder: 3 },
  { documentId: 'f4', question: 'What should I bring to my first class?', answer: para('Comfortable training clothes, a water bottle and a towel. Arrive 10 minutes early to meet your coach.'), isFeatured: false, sortOrder: 4 },
  { documentId: 'f5', question: 'Is there parking available?', answer: para('Yes, free parking is available. Ask at the front desk if you need directions.'), isFeatured: false, sortOrder: 5 },
];

const list = (faqs.length > 0 ? faqs : fallbackFaqs).slice().sort((a, b) => a.sortOrder - b.sortOrder);
const cats = categories
  .map((c) => ({ ...c, count: list.filter((f) => f.category?.documentId === c.documentId).length }))
  .filter((c) => c.count > 0)
  .sort((a, b) => a.sortOrder - b.sortOrder);
const uncategorised = list.filter((f) => !f.category).length;
const popular = list.filter((f) => f.isFeatured).slice(0, 4);

const items = list.map((f) => ({
  id: `q-${f.documentId}`,
  question: f.question,
  html: blocksToHtml(f.answer as any),
  cat: f.category?.slug ?? 'other',
  catName: f.category?.name ?? 'General',
}));

const whatsapp = (global?.whatsapp ?? global?.phone ?? '').replace(/\D/g, '');
const seo = {
  metaTitle: 'FAQ — The Wolverine Hub',
  metaDescription: 'Answers about booking classes, paying per session, cancellations, equipment, parking and more.',
};
---

<PageLayout {seo} {global} jsonLd={faqSchema(list)}>
  <!-- ═════════ Hero + search ═════════ -->
  <section class="twh-fq-hero">
    <div class="twh-fq-hero__bg" aria-hidden="true">
      <WolverineSlash class="twh-fq-hero__slash" />
      <span class="twh-fq-hero__q">?</span>
    </div>
    <div class="twh-fq-wrap twh-fq-hero__inner">
      <p class="twh-fq-eyebrow"><span aria-hidden="true">/</span> {pageHero?.eyebrow ?? 'FAQ'}</p>
      <h1 class="twh-fq-hero__title" set:html={pageHero ? pageHero.heading.replace(/\n/g, '<br/>') : 'Got<br/>Questions?'} />
      <p class="twh-fq-hero__sub">{pageHero?.subheading ?? 'Search the answers, or browse by topic.'}</p>

      <form class="twh-fq-search" role="search" id="fq-form">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <label for="fq-search" class="sr-only">Search the FAQ</label>
        <input id="fq-search" type="search" placeholder="Search — e.g. cancel, parking, payment…" autocomplete="off" spellcheck="false" />
        <kbd aria-hidden="true">/</kbd>
        <button type="button" class="twh-fq-search__clear" id="fq-clear" aria-label="Clear search" hidden>×</button>
      </form>

      {popular.length > 0 && (
        <div class="twh-fq-popular">
          <span>Popular:</span>
          {popular.map((p) => <a href={`#q-${p.documentId}`} class="twh-fq-popular__chip" data-jump={`q-${p.documentId}`}>{p.question}</a>)}
        </div>
      )}
    </div>
  </section>

  <!-- ═════════ Browser ═════════ -->
  <section class="twh-fq-main" aria-label="Frequently asked questions">
    <div class="twh-fq-wrap twh-fq-main__grid">

      <nav class="twh-fq-rail" aria-label="Topics">
        <p class="twh-fq-rail__title">Topics</p>
        <ul role="list">
          <li><button type="button" class="twh-fq-topic" data-cat="all" aria-pressed="true"><span>All questions</span><b>{list.length}</b></button></li>
          {cats.map((c) => <li><button type="button" class="twh-fq-topic" data-cat={c.slug} aria-pressed="false"><span>{c.name}</span><b>{c.count}</b></button></li>)}
          {uncategorised > 0 && <li><button type="button" class="twh-fq-topic" data-cat="other" aria-pressed="false"><span>General</span><b>{uncategorised}</b></button></li>}
        </ul>
      </nav>

      <div class="twh-fq-results">
        <div class="twh-fq-bar">
          <p class="twh-fq-count" id="fq-count" aria-live="polite">{items.length} questions</p>
          <button type="button" class="twh-fq-toggle" id="fq-toggle" data-state="collapsed">Expand all</button>
        </div>

        <ol class="twh-fq-list" id="fq-list" role="list">
          {items.map((q) => (
            <li class="twh-fq-item" id={q.id} data-cat={q.cat}>
              <details>
                <summary>
                  <span class="twh-fq-item__tag">{q.catName}</span>
                  <span class="twh-fq-item__q" data-q>{q.question}</span>
                  <span class="twh-fq-item__icon" aria-hidden="true"></span>
                </summary>
                <div class="twh-fq-item__a">
                  <div class="twh-fq-item__body" data-a>{q.html ? <Fragment set:html={q.html} /> : <p>Answer coming soon.</p>}</div>
                  <button type="button" class="twh-fq-item__link" data-copy-link={`#${q.id}`}>Copy link</button>
                </div>
              </details>
            </li>
          ))}
        </ol>

        <div class="twh-fq-empty" id="fq-empty" hidden>
          <p class="twh-fq-empty__title">No answers found</p>
          <p class="twh-fq-empty__text">Try different words — or ask us directly and we'll reply within 24 hours.</p>
          <a href="/contact" class="twh-btn twh-btn--primary twh-btn--md">Ask a question</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ Still need help ═════════ -->
  <section class="twh-fq-help">
    <div class="twh-fq-wrap">
      <div class="twh-fq-help__card">
        <div>
          <p class="twh-fq-eyebrow"><span aria-hidden="true">/</span> Still stuck?</p>
          <h2 class="twh-fq-help__title">Talk to a human.</h2>
          <p class="twh-fq-help__text">Can't find what you need? Message us — we usually reply the same day.</p>
        </div>
        <div class="twh-fq-help__actions">
          <a href="/contact" class="twh-btn twh-btn--primary twh-btn--lg">Contact us</a>
          {whatsapp.length >= 8 && <a href={`https://wa.me/${whatsapp}`} class="twh-btn twh-btn--ghost twh-btn--lg" target="_blank" rel="noopener noreferrer">WhatsApp</a>}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>@import '../styles/pages/twh-faq.css';</style>

<script>
  import { initFaq } from '../scripts/interactions/faq';
  initFaq();
</script>
