---
// Dev-only menu comparison page
if (import.meta.env.NODE_ENV === 'production') {
  return Astro.redirect('/', 302);
}

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import SlashMenu from '../components/layout/SlashMenu.astro';
import AltMenuReveal from '../components/layout/AltMenuReveal.astro';
import AltMenuSlide from '../components/layout/AltMenuSlide.astro';
import { getHeader, getGlobal } from '../lib/strapi/queries';

let header, global;
try {
  [header, global] = await Promise.all([getHeader(), getGlobal()]);
} catch { /* fallback */ }
---

<BaseLayout seo={{ metaTitle: 'Menu Preview', metaDescription: 'Compare three menu options' }} noindex>

  <!-- Shared header trigger -->
  <Header {header} {global} menuId="active-menu" />

  <!-- Slot for the active menu — swapped by JS -->
  <div id="menu-slot">
    <SlashMenu {header} {global} id="active-menu" />
  </div>

  <!-- Hidden alternatives (rendered for JS to swap in) -->
  <template id="tpl-slash">
    <!-- Option 1 already in slot -->
  </template>

  <main id="main-content" style="padding-top:100px;min-height:100dvh;background:var(--color-twh-black);">
    <div style="max-width:680px;margin:0 auto;padding:3rem 2rem;">

      <h1 style="font-size:clamp(1.5rem,4vw,2.5rem);margin-bottom:0.5rem;">
        Menu Preview
      </h1>
      <p style="color:var(--color-twh-grey-400);margin-bottom:3rem;">
        Click an option below to switch menu types, then use the ☰ trigger top-right to open it.
      </p>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:3rem;" id="menu-switcher">

        <button
          data-menu="slash"
          class="twh-preview-card twh-preview-card--active"
          type="button"
        >
          <span class="twh-preview-card__num">01</span>
          <strong class="twh-preview-card__name">The Slash Menu</strong>
          <span class="twh-preview-card__tag">Primary / Recommended</span>
          <p class="twh-preview-card__desc">Three diagonal panels tear open. Giant indexed items + slash-shaped media preview. Award-level.</p>
        </button>

        <button
          data-menu="reveal"
          class="twh-preview-card"
          type="button"
        >
          <span class="twh-preview-card__num">02</span>
          <strong class="twh-preview-card__name">The Reveal</strong>
          <span class="twh-preview-card__tag">Alternative</span>
          <p class="twh-preview-card__desc">Full-screen overlay. Items stagger in from below, right-aligned. Slash SVG on the left. Editorial.</p>
        </button>

        <button
          data-menu="slide"
          class="twh-preview-card"
          type="button"
        >
          <span class="twh-preview-card__num">03</span>
          <strong class="twh-preview-card__name">The Slide</strong>
          <span class="twh-preview-card__tag">Alternative</span>
          <p class="twh-preview-card__desc">Right-edge drawer. Index numbers + descriptions. Backdrop dims the page. Structured, premium.</p>
        </button>

      </div>

      <div style="background:var(--color-twh-ink);border:1px solid var(--color-twh-grey-900);border-radius:8px;padding:1.5rem;font-size:0.875rem;color:var(--color-twh-grey-400);">
        <strong style="color:var(--color-twh-white);display:block;margin-bottom:0.5rem;">How to review:</strong>
        <ol style="padding-left:1.25rem;margin:0;line-height:1.8;">
          <li>Click an option card above to switch</li>
          <li>Click the ☰ trigger (top right) to open the menu</li>
          <li>Test on desktop and mobile</li>
          <li>Press Escape or click the trigger again to close</li>
          <li>Tell me which one you want — or mix elements from different options</li>
        </ol>
      </div>

    </div>
  </main>

</BaseLayout>

<!-- Inject menu markup via hidden divs so JS can swap them -->
<div id="markup-slash" hidden>
  <SlashMenu {header} {global} id="active-menu" />
</div>
<div id="markup-reveal" hidden>
  <AltMenuReveal {header} {global} id="active-menu" />
</div>
<div id="markup-slide" hidden>
  <AltMenuSlide {header} {global} id="active-menu" />
</div>

<style>
  .twh-preview-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    background: var(--color-twh-ink);
    border: 2px solid var(--color-twh-grey-900);
    border-radius: 8px;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    font-family: var(--font-body);
    color: var(--color-twh-white);
  }

  .twh-preview-card:hover { border-color: var(--color-twh-grey-600); }

  .twh-preview-card--active {
    border-color: var(--color-twh-yellow);
    background: rgba(255,194,14,0.05);
  }

  .twh-preview-card__num {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-twh-grey-600);
  }

  .twh-preview-card--active .twh-preview-card__num { color: var(--color-twh-yellow); }

  .twh-preview-card__name {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .twh-preview-card__tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-twh-grey-500);
  }

  .twh-preview-card--active .twh-preview-card__tag { color: var(--color-twh-yellow); }

  .twh-preview-card__desc {
    font-size: 0.8125rem;
    color: var(--color-twh-grey-400);
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  @media (max-width: 640px) {
    #menu-switcher { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initMenu } from '../scripts/interactions/menu';

  // Map of menu type to their pre-rendered HTML
  const slot = document.getElementById('menu-slot')!;
  const markups: Record<string, HTMLElement | null> = {
    slash:  document.getElementById('markup-slash'),
    reveal: document.getElementById('markup-reveal'),
    slide:  document.getElementById('markup-slide'),
  };

  let currentMenu = 'slash';

  // Init with default menu
  initMenu();

  document.querySelectorAll<HTMLButtonElement>('[data-menu]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.menu!;
      if (type === currentMenu) return;

      // Swap menu HTML
      const markup = markups[type];
      if (markup) {
        slot.innerHTML = markup.innerHTML;
        currentMenu = type;

        // Re-init menu controller for new DOM
        initMenu();
      }

      // Update active card
      document.querySelectorAll('.twh-preview-card').forEach((c) => c.classList.remove('twh-preview-card--active'));
      btn.classList.add('twh-preview-card--active');
    });
  });
</script>
