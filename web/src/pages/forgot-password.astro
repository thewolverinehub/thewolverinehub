---
import AuthLayout from '../layouts/AuthLayout.astro';
import Field from '../components/ui/Field.astro';

export const prerender = false;
if (Astro.locals.session) return Astro.redirect('/account', 302);
---

<AuthLayout title="Forgot password" subtitle="Enter the email you signed up with and we will send you a link to choose a new password." eyebrow="Members" metaTitle="Forgot password — The Wolverine Hub">
  <form class="twh-auth__form" data-auth-form data-endpoint="/api/auth/forgot" data-success="If that email has an account, a reset link is on its way. Check your inbox." data-hide-on-success="true" novalidate>
    <Field name="email" label="Email" type="email" autocomplete="email" required />
    <p class="twh-auth__status" data-form-status hidden></p>
    <button type="submit" class="twh-btn twh-btn--primary twh-btn--lg twh-auth__submit">Send reset link</button>
  </form>
  <p class="twh-auth__alt"><a href="/login">← Back to sign in</a></p>
</AuthLayout>
