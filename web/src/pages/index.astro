---
// Phase 3 baseline page — replaced with the full CMS-driven home page in Phase 8.
const title = "The Wolverine Hub — Sri Lanka's Premier Training Centre";
const description =
  "Where iron meets instinct. Classes, coaching and programs built for those who mean it. Coming soon to Colombo.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={import.meta.env.SITE_INDEXING === "true" ? "index, follow" : "noindex, nofollow"} />
    <title>{title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --black: #0A0A0B;
        --white: #FFFFFF;
        --yellow: #FFC20E;
        --red: #D7141A;
        color-scheme: dark;
      }

      html { font-family: system-ui, -apple-system, sans-serif; background: var(--black); color: var(--white); }

      a:focus-visible {
        outline: 3px solid var(--yellow);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: var(--yellow);
        color: var(--black);
        padding: 0.5rem 1rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 0 0 4px 4px;
        z-index: 100;
      }
      .skip-link:focus { top: 0; }

      header {
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #1e1e22;
      }

      .logo {
        font-size: 1.125rem;
        font-weight: 900;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--white);
        text-decoration: none;
      }
      .logo span { color: var(--yellow); }

      nav a {
        color: #a0a0a8;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        margin-left: 2rem;
        transition: color 0.15s;
      }
      nav a:hover { color: var(--white); }

      main {
        min-height: calc(100dvh - 8rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 2rem;
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--yellow);
        margin-bottom: 1.5rem;
      }

      h1 {
        font-size: clamp(2rem, 8vw, 5rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        max-width: 14ch;
        margin-bottom: 1.5rem;
      }

      h1 em {
        font-style: normal;
        color: var(--yellow);
      }

      .sub {
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        color: #a0a0a8;
        max-width: 40ch;
        line-height: 1.6;
        margin-bottom: 3rem;
      }

      .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--yellow);
        color: var(--black);
        font-weight: 800;
        font-size: 0.9375rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 1rem 2rem;
        border-radius: 4px;
        transition: opacity 0.15s;
      }
      .cta:hover { opacity: 0.88; }
      .cta:focus-visible { outline-color: var(--white); }

      .status-badge {
        margin-top: 4rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid #2a2a30;
        border-radius: 999px;
        font-size: 0.75rem;
        color: #a0a0a8;
      }
      .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--yellow);
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }

      footer {
        text-align: center;
        padding: 1.5rem 2rem;
        font-size: 0.75rem;
        color: #555560;
        border-top: 1px solid #1e1e22;
      }

      @media (max-width: 600px) {
        nav { display: none; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header>
      <a href="/" class="logo">The <span>Wolverine</span> Hub</a>
      <nav aria-label="Primary">
        <a href="#classes">Classes</a>
        <a href="#schedule">Schedule</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main-content">
      <span class="eyebrow" aria-label="Status: Coming soon">Coming Soon · Colombo, Sri Lanka</span>

      <h1>Where Iron Meets <em>Instinct.</em></h1>

      <p class="sub">
        Classes, coaching and programs built for those who mean it.
        The Wolverine Hub opens soon.
      </p>

      <a href="mailto:train@thewolverinehub.com" class="cta" aria-label="Get notified when we launch">
        Get Notified
      </a>

      <div class="status-badge" role="status" aria-live="polite">
        <span class="dot" aria-hidden="true"></span>
        Site in development
      </div>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} The Wolverine Hub. All rights reserved.</p>
    </footer>
  </body>
</html>
