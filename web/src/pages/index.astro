---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import HeroVideo from '../components/sections/HeroVideo.astro';
import StatCounters from '../components/sections/StatCounters.astro';
import Marquee from '../components/sections/Marquee.astro';
import ClassRail from '../components/sections/ClassRail.astro';
import FeatureSplit from '../components/sections/FeatureSplit.astro';
import CoachCarousel from '../components/sections/CoachCarousel.astro';
import TestimonialSlider from '../components/sections/TestimonialSlider.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import { getGlobal, getPageBySlug } from '../lib/strapi/queries';
import type { StrapiSeo } from '../lib/strapi/types';

let global, homePage;
try {
  [global, homePage] = await Promise.all([getGlobal(), getPageBySlug('home')]);
} catch { /* CMS offline — fallbacks render below */ }

const seo: StrapiSeo = homePage?.seo ?? {
  metaTitle: 'Where Iron Meets Instinct',
  metaDescription: "Sri Lanka's most demanding training ground. Classes, coaching and training built for those who mean it.",
};

// If Strapi has sections configured, use the dynamic renderer.
// Otherwise render each section component with its own fallback data.
const hasSections = (homePage?.sections?.length ?? 0) > 0;
---

<PageLayout {seo} {global}>
  {hasSections ? (
    <SectionRenderer sections={homePage!.sections} />
  ) : (
    <>
      <HeroVideo />
      <StatCounters />
      <Marquee />
      <ClassRail />
      <FeatureSplit />
      <CoachCarousel />
      <TestimonialSlider />
      <CTABanner />
    </>
  )}
</PageLayout>
