---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCoachBySlug, getGlobal } from '../../lib/strapi/queries';
import { blocksToHtml } from '../../lib/strapi/blocks';

const { slug } = Astro.params;

let global, coach;
try {
  [global, coach] = await Promise.all([getGlobal(), getCoachBySlug(slug!)]);
} catch { /* CMS offline */ }

if (!coach) return Astro.redirect('/coaches', 307);

const bioHtml = blocksToHtml(coach.bio);

const seo = coach.seo ?? {
  metaTitle: `${coach.name} — The Wolverine Hub`,
  metaDescription: coach.shortBio ?? `Meet ${coach.name}, ${coach.role ?? 'coach'} at The Wolverine Hub.`,
};
---

<PageLayout {seo} {global}>
  <article class="twh-coach-detail">

    <!-- Hero split: photo + info -->
    <div class="twh-coach-detail__hero">
      <div class="twh-coach-detail__photo">
        {coach.photo ? (
          <img src={coach.photo.url} alt={coach.photo.alternativeText ?? coach.name} />
        ) : (
          <div class="twh-coach-detail__photo-placeholder" aria-hidden="true">/</div>
        )}
      </div>

      <div class="twh-coach-detail__hero-body">
        {coach.isHeadCoach && (
          <span class="twh-badge twh-badge--yellow" style="align-self:flex-start;">Head Coach</span>
        )}
        {coach.role && <p class="twh-coach-detail__role">{coach.role}</p>}
        <h1 class="twh-coach-detail__name">{coach.name}</h1>
        {coach.shortBio && <p class="twh-coach-detail__short-bio">{coach.shortBio}</p>}

        {coach.specialties && coach.specialties.trim().length > 0 && (
          <div class="twh-coach-detail__tags">
            {coach.specialties.split('\n').filter((s: string) => s.trim() !== '').map((s: string) => (
              <span class="twh-coach-detail__tag">{s}</span>
            ))}
          </div>
        )}

        {coach.instagram && (
          <a
            href={`https://instagram.com/${coach.instagram.replace('@', '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="twh-btn twh-btn--ghost twh-btn--sm"
            style="align-self:flex-start;display:inline-flex;align-items:center;gap:0.5rem;"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z" /></svg>
            @{coach.instagram.replace('@', '')}
          </a>
        )}
      </div>
    </div>

    <!-- Bio + sidebar -->
    <div class="twh-coach-detail__body-section">
      <div class="twh-coach-detail__prose">
        {bioHtml ? (
          <Fragment set:html={bioHtml} />
        ) : (
          <p style="color:rgba(255,255,255,0.35);">Full bio coming soon.</p>
        )}
      </div>

      <aside>
        <div class="twh-coach-detail__side-card">
          <h2 class="twh-coach-detail__side-heading">At a Glance</h2>
          <ul class="twh-coach-detail__spec-list">
            {coach.yearsExperience && (
              <li class="twh-coach-detail__spec-item">{coach.yearsExperience} years experience</li>
            )}
            {(coach.disciplines ?? []).map(d => (
              <li class="twh-coach-detail__spec-item">{d.name}</li>
            ))}
            {(coach.specialties ?? '').split('\n').filter((s: string) => s.trim() !== '').map((s: string) => (
              <li class="twh-coach-detail__spec-item">{s}</li>
            ))}
          </ul>
        </div>

        <a href="/contact" class="twh-btn twh-btn--primary twh-btn--md" style="width:100%;justify-content:center;margin-top:1.5rem;">
          Train With {coach.name.split(' ')[0]}
        </a>
        <a href="/coaches" class="twh-btn twh-btn--ghost twh-btn--sm" style="width:100%;justify-content:center;margin-top:0.75rem;">
          ← All Coaches
        </a>
      </aside>
    </div>
  </article>
</PageLayout>

<style is:global>@import '../../styles/pages/twh-coach-detail.css';</style>
