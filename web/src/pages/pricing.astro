---
import PageLayout from '../layouts/PageLayout.astro';
import { getClasses, getFaqs, getGlobal, getPageBySlug } from '../lib/strapi/queries';
import { blocksToHtml } from '../lib/strapi/blocks';
import { formatLKR } from '../lib/utils/colombo';
import type { StrapiClass, StrapiFaq, StrapiPageHeroSection } from '../lib/strapi/types';

let global, classes: StrapiClass[] = [], faqs: StrapiFaq[] = [], pageData: Awaited<ReturnType<typeof getPageBySlug>> = null;
try {
  [global, classes, faqs, pageData] = await Promise.all([getGlobal(), getClasses(), getFaqs(), getPageBySlug('pricing')]);
} catch { /* CMS offline */ }

const pageHero = pageData?.sections?.find((s) => s.__component === 'sections.page-hero') as StrapiPageHeroSection | undefined;
const logged = Boolean(Astro.locals.session);

// Group classes by price: free first, then ascending. The group with the most classes is "Most popular".
const groups = Array.from(
  classes.reduce((map, c) => {
    const key = c.isFree || (c.price ?? 0) === 0 ? 0 : c.price;
    map.set(key, [...(map.get(key) ?? []), c]);
    return map;
  }, new Map<number, StrapiClass[]>()),
).sort((a, b) => a[0] - b[0]);
const popularPrice = [...groups].sort((a, b) => b[1].length - a[1].length)[0]?.[0];

const bookingFaqs = faqs.filter((f) => f.category?.slug === 'booking-payments').slice(0, 5);

const steps = [
  { n: '01', title: 'Create your account', text: 'Sign up free with your name, phone and email — it takes a minute.' },
  { n: '02', title: 'Pick a class & date', text: 'Choose a session from the schedule and see exactly how many spots are left.' },
  { n: '03', title: 'Pay & train', text: 'Pay for that session online. You get a confirmation, and a reminder the evening before.' },
];

const seo = {
  metaTitle: 'Class Pricing — The Wolverine Hub',
  metaDescription: 'No memberships, no lock-ins. See the price of every class and pay only for the sessions you book.',
};
---

<PageLayout {seo} {global}>
  <div class="twh-page-hero">
    <div class="twh-page-hero__inner">
      <p class="twh-page-hero__eyebrow">{pageHero?.eyebrow ?? 'Pricing'}</p>
      <h1 class="twh-page-hero__heading" set:html={pageHero ? pageHero.heading.replace(/\n/g, '<br/>') : 'Pay Per<br/>Class.'} />
      <p class="twh-page-hero__sub">{pageHero?.subheading ?? 'No memberships. No lock-ins. Book the sessions you want and pay for each one.'}</p>
    </div>
  </div>

  <section class="twh-rates" aria-labelledby="rates-h">
    <div class="twh-rates__inner">
      <h2 id="rates-h" class="twh-rates__title"><span aria-hidden="true">/</span> Rates per session</h2>

      {groups.length === 0 ? (
        <p class="twh-rates__empty">Class rates are coming soon — <a href="/contact">contact us</a> for details.</p>
      ) : (
        <ul class="twh-rates__grid" role="list">
          {groups.map(([price, list]) => (
            <li class={`twh-rate${price === popularPrice ? ' is-popular' : ''}${price === 0 ? ' is-free' : ''}`}>
              {price === popularPrice && <span class="twh-rate__flag">Most classes</span>}
              <p class="twh-rate__amount">{price === 0 ? 'FREE' : formatLKR(price)}</p>
              <p class="twh-rate__per">{price === 0 ? 'no charge' : 'per session'}</p>
              <ul class="twh-rate__classes" role="list">
                {list.map((c) => (
                  <li><a href={`/classes/${c.slug}`}><b>{c.name}</b><small>{c.tagline}</small></a></li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="twh-rates twh-rates--steps" aria-labelledby="how-h">
    <div class="twh-rates__inner">
      <h2 id="how-h" class="twh-rates__title"><span aria-hidden="true">/</span> How it works</h2>
      <ol class="twh-steps" role="list">
        {steps.map((s) => (
          <li class="twh-step"><span class="twh-step__n">{s.n}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  {bookingFaqs.length > 0 && (
    <section class="twh-rates" aria-labelledby="faq-h">
      <div class="twh-rates__inner twh-rates__inner--narrow">
        <h2 id="faq-h" class="twh-rates__title"><span aria-hidden="true">/</span> Good to know</h2>
        <div class="twh-rates__faq">
          {bookingFaqs.map((f) => (
            <details class="twh-faqlite">
              <summary>{f.question}</summary>
              <div set:html={blocksToHtml(f.answer as any)} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="twh-rates twh-rates--cta">
    <div class="twh-rates__inner">
      <p class="twh-rates__cta-text">Ready to train?</p>
      <div class="twh-rates__cta-btns">
        <a href="/schedule" class="twh-btn twh-btn--primary twh-btn--lg">See the schedule</a>
        {!logged && <a href="/register" class="twh-btn twh-btn--ghost twh-btn--lg">Create an account</a>}
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>@import '../styles/pages/twh-pricing-page.css';</style>
