---
import AuthLayout from '../layouts/AuthLayout.astro';
import Field from '../components/ui/Field.astro';
import { readResetToken } from '../lib/auth/session';

export const prerender = false;
if (Astro.locals.session) return Astro.redirect('/account', 302);

const token = Astro.url.searchParams.get('token') ?? '';
const valid = Boolean(readResetToken(token));
---

<AuthLayout title="New password" subtitle="Choose a new password for your account." eyebrow="Members" metaTitle="Reset password — The Wolverine Hub">
  {valid ? (
    <form class="twh-auth__form" data-auth-form data-endpoint="/api/auth/reset" novalidate>
      <input type="hidden" name="token" value={token} />
      <div>
        <Field name="password" label="New password" type="password" autocomplete="new-password" required strength="#pw-strength" hint="At least 8 characters, with a letter and a number." />
        <p class="twh-strength" id="pw-strength" data-score="0" aria-live="polite"><span></span></p>
      </div>
      <Field name="passwordConfirm" label="Confirm new password" type="password" autocomplete="new-password" required />
      <p class="twh-auth__status" data-form-status hidden></p>
      <button type="submit" class="twh-btn twh-btn--primary twh-btn--lg twh-auth__submit">Update password</button>
    </form>
  ) : (
    <>
      <p class="twh-auth__status" data-kind="error">This reset link is invalid or has expired.</p>
      <p class="twh-auth__alt"><a href="/forgot-password">Request a new link</a></p>
    </>
  )}
</AuthLayout>

