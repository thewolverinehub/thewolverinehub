---
import PageLayout from '../layouts/PageLayout.astro';
import { getScheduleSlots, getGlobal, getPageBySlug } from '../lib/strapi/queries';
import type { StrapiScheduleSlot, StrapiPageHeroSection } from '../lib/strapi/types';
import {
  DAYS, type Day, getColomboNow, weekDates, dateLabel, toMinutes, fmtMinutes, fmtDuration,
  colomboClockSeconds, colomboDateLong,
} from '../lib/utils/colombo';
import {
  slotState, findNext, nextLabel, nowMinutes, STATE_LABEL, type SlotLite,
} from '../lib/utils/schedule';

let global, slots: StrapiScheduleSlot[] = [], pageData: Awaited<ReturnType<typeof getPageBySlug>> = null;
try {
  [global, slots, pageData] = await Promise.all([getGlobal(), getScheduleSlots(), getPageBySlug('schedule')]);
} catch { /* CMS offline */ }

const pageHero = pageData?.sections?.find(s => s.__component === 'sections.page-hero') as StrapiPageHeroSection | undefined;

// ── Sri Lanka "now" — drives today / dates / live status (never the server or device zone) ──
const now = getColomboNow();
const dates = weekDates(now.dateISO, now.day);
const defaultDay: Day = now.day;

// ── Normalise slots ────────────────────────────────────────────
const intensityAccent: Record<string, { bg: string; ink: string }> = {
  low:     { bg: 'var(--color-twh-blue)',     ink: 'var(--color-twh-white)' },
  medium:  { bg: 'var(--color-twh-yellow)',   ink: 'var(--color-twh-black)' },
  high:    { bg: 'var(--color-twh-red)',      ink: 'var(--color-twh-white)' },
  extreme: { bg: 'var(--color-twh-red-deep)', ink: 'var(--color-twh-white)' },
};
const neutralAccent = { bg: 'var(--color-twh-grey-600)', ink: 'var(--color-twh-white)' };

const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();

interface Item extends SlotLite {
  intensity: string;
  level: string;
  coach: string;
  capacity: number;
  duration: string;
  start: string;
  end: string;
  accent: { bg: string; ink: string };
}

const items: Item[] = slots
  .filter(s => (DAYS as readonly string[]).includes(s.weekday))
  .map(s => {
    const startMin = toMinutes(s.startTime);
    const endMin = toMinutes(s.endTime);
    const intensity = s.class?.intensity ?? '';
    return {
      id: s.documentId,
      day: s.weekday as Day,
      startMin,
      endMin,
      name: s.class?.name ?? 'Class session',
      room: s.room ?? '',
      slug: s.class?.slug ?? '',
      intensity,
      level: s.class?.level ?? '',
      coach: s.coach?.name ?? '',
      capacity: s.capacity ?? 0,
      duration: fmtDuration(startMin, endMin),
      start: fmtMinutes(startMin),
      end: fmtMinutes(endMin),
      accent: intensityAccent[intensity] ?? neutralAccent,
    };
  })
  .sort((a, b) => a.startMin - b.startMin || a.endMin - b.endMin);

const byDay = Object.fromEntries(DAYS.map(d => [d, items.filter(i => i.day === d)])) as Record<Day, Item[]>;

// Class filter chips (only classes that actually have a slot)
const classOptions = Array.from(
  new Map(items.filter(i => i.slug).map(i => [i.slug, i.name])).entries()
).map(([slug, name]) => ({ slug, name })).sort((a, b) => a.name.localeCompare(b.name));

// Week-overview bands (Colombo local time)
const BANDS = [
  { key: 'morning',   label: 'Morning',   range: 'Before 12 PM', test: (m: number) => m < 12 * 60 },
  { key: 'afternoon', label: 'Afternoon', range: '12 – 5 PM',    test: (m: number) => m >= 12 * 60 && m < 17 * 60 },
  { key: 'evening',   label: 'Evening',   range: 'After 5 PM',   test: (m: number) => m >= 17 * 60 },
];

// ── Initial "next up" (client keeps it live) ───────────────────
const next = findNext(items, now);
const nextText = nextLabel(next, now);

const dayName = (d: Day) => d.charAt(0).toUpperCase() + d.slice(1);

const seo = {
  metaTitle: 'Class Schedule — The Wolverine Hub',
  metaDescription: 'Browse the weekly class timetable in Sri Lanka time. Find the right time for Boxing, Muay Thai, BJJ, Strength & more.',
};
---

<PageLayout {seo} {global}>
  <div class="twh-page-hero">
    <div class="twh-page-hero__inner">
      <p class="twh-page-hero__eyebrow">{pageHero?.eyebrow ?? 'Timetable'}</p>
      <h1 class="twh-page-hero__heading" set:html={pageHero ? pageHero.heading.replace(/\n/g, '<br/>') : 'Weekly<br/>Schedule.'} />
      <p class="twh-page-hero__sub">{pageHero?.subheading ?? 'Classes run seven days a week. Pick a day and find your next session.'}</p>
    </div>
  </div>

  <section
    class="twh-schedule"
    id="schedule"
    aria-label="Class schedule"
    data-today={now.day}
    data-default-day={defaultDay}
  >
    <div class="twh-schedule__inner">

      {items.length === 0 ? (
        <p class="twh-schedule__none">
          Schedule coming soon — <a href="/contact">contact us</a> for class times.
        </p>
      ) : (
        <>
          <!-- Live Sri Lanka clock + next class -->
          <div class="twh-schedule__bar">
            <div class="twh-schedule__clock">
              <p class="twh-schedule__clock-label">
                <span class="twh-schedule__pulse" aria-hidden="true"></span>
                Sri Lanka Time <span class="twh-schedule__clock-gmt">· GMT+5:30</span>
              </p>
              <p class="twh-schedule__clock-time" id="sch-clock">{colomboClockSeconds()}</p>
              <p class="twh-schedule__clock-date" id="sch-date">{colomboDateLong()}</p>
            </div>

            <div class={`twh-schedule__next${nextText.live ? ' is-live' : ''}`} id="sch-next" aria-live="polite">
              <p class="twh-schedule__next-kicker" id="sch-next-kicker">{nextText.kicker}</p>
              <p class="twh-schedule__next-title" id="sch-next-title">{nextText.title}</p>
              <p class="twh-schedule__next-detail" id="sch-next-detail">{nextText.detail}</p>
              {next && (
                <button
                  type="button"
                  class="twh-btn twh-btn--secondary twh-btn--sm twh-schedule__next-go"
                  id="sch-next-go"
                  data-goto-day={next.slot.day}
                >
                  View in timetable
                </button>
              )}
            </div>
          </div>

          <!-- Controls: class filter + view toggle -->
          <div class="twh-schedule__controls">
            <div class="twh-schedule__chips" role="group" aria-label="Filter by class">
              <button type="button" class="twh-schedule__chip" data-class="all" aria-pressed="true">All classes</button>
              {classOptions.map(c => (
                <button type="button" class="twh-schedule__chip" data-class={c.slug} aria-pressed="false">{c.name}</button>
              ))}
            </div>

            <div class="twh-schedule__views" role="group" aria-label="Timetable view">
              <button type="button" class="twh-schedule__view" data-view="day" aria-pressed="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Day
              </button>
              <button type="button" class="twh-schedule__view" data-view="week" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
                Week
              </button>
            </div>
          </div>

          <!-- ═════════════ DAY VIEW ═════════════ -->
          <div class="twh-schedule__dayview" id="sch-dayview">

            <div class="twh-schedule__tabs" role="tablist" aria-label="Select a day">
              {DAYS.map(day => {
                const d = dateLabel(dates[day]);
                return (
                  <button
                    type="button"
                    class={`twh-schedule__tab${day === now.day ? ' is-today' : ''}`}
                    role="tab"
                    data-day={day}
                    data-date={dates[day]}
                    aria-selected={day === defaultDay ? 'true' : 'false'}
                    tabindex={day === defaultDay ? 0 : -1}
                    aria-controls={`panel-${day}`}
                    id={`tab-${day}`}
                  >
                    <span class="twh-schedule__tab-dow" aria-hidden="true">{day.slice(0, 3)}</span>
                    <span class="sr-only">{dayName(day)}, {d.long}</span>
                    <span class="twh-schedule__tab-num" aria-hidden="true">{d.num}</span>
                    <span class="twh-schedule__tab-month" aria-hidden="true">{d.month}</span>
                    <span class="twh-schedule__tab-count" data-count aria-hidden="true">{byDay[day].length}</span>
                    {day === now.day && <span class="twh-schedule__tab-today" aria-hidden="true">Today</span>}
                  </button>
                );
              })}
            </div>

            {DAYS.map(day => {
              const d = dateLabel(dates[day]);
              const isToday = day === now.day;
              return (
                <div
                  class="twh-schedule__panel"
                  role="tabpanel"
                  id={`panel-${day}`}
                  aria-labelledby={`tab-${day}`}
                  data-day={day}
                  hidden={day !== defaultDay}
                >
                  <div class="twh-schedule__panel-head">
                    <h2 class="twh-schedule__panel-title">
                      {dayName(day)}
                      {isToday && <span class="twh-schedule__panel-today">Today</span>}
                    </h2>
                    <p class="twh-schedule__panel-date">{d.long} <span>· Sri Lanka time</span></p>
                  </div>

                  {byDay[day].length === 0 ? (
                    <p class="twh-schedule__empty-day">No classes scheduled on {dayName(day)}.</p>
                  ) : (
                    <ul class="twh-schedule__slots" role="list">
                      {byDay[day].map(slot => {
                        const state = isToday ? slotState(slot, nowMinutes(now)) : 'upcoming';
                        return (
                          <li
                            class="twh-schedule__slot"
                            style={`--accent: ${slot.accent.bg}; --accent-ink: ${slot.accent.ink};`}
                            data-state={state}
                            data-id={slot.id}
                            data-day={slot.day}
                            data-start={slot.startMin}
                            data-end={slot.endMin}
                            data-name={slot.name}
                            data-room={slot.room}
                            data-class={slot.slug}
                          >
                            <div class="twh-schedule__time">
                              <span class="twh-schedule__time-start">{slot.start}</span>
                              <span class="twh-schedule__time-end">to {slot.end}</span>
                              <span class="twh-schedule__duration">{slot.duration}</span>
                            </div>

                            <div class="twh-schedule__main">
                              <div class="twh-schedule__tags">
                                {slot.intensity && <span class="twh-schedule__intensity">{slot.intensity}</span>}
                                {slot.level && <span class="twh-schedule__level">{slot.level === 'all' ? 'All levels' : slot.level}</span>}
                                <span class="twh-schedule__status" data-status>{isToday ? STATE_LABEL[state] : ''}</span>
                              </div>
                              <h3 class="twh-schedule__class-name">
                                {slot.slug ? <a href={`/classes/${slot.slug}`}>{slot.name}</a> : slot.name}
                              </h3>
                              <ul class="twh-schedule__meta" role="list">
                                {slot.coach && (
                                  <li class="twh-schedule__coach">
                                    <span class="twh-schedule__avatar" aria-hidden="true">{initials(slot.coach)}</span>
                                    {slot.coach}
                                  </li>
                                )}
                                {slot.room && (
                                  <li>
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14s5-4.2 5-8A5 5 0 0 0 3 6c0 3.8 5 8 5 8Z" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="6" r="1.8" stroke="currentColor" stroke-width="1.5"/></svg>
                                    {slot.room}
                                  </li>
                                )}
                                {slot.capacity > 0 && (
                                  <li>
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="6" cy="5.5" r="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M1.5 14c.4-2.6 2.2-4 4.5-4s4.1 1.4 4.5 4M11 3.2a2.5 2.5 0 0 1 0 4.6M14.5 14c-.2-1.6-1-2.8-2.3-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                    {slot.capacity} spots
                                  </li>
                                )}
                              </ul>
                            </div>

                            <div class="twh-schedule__action">
                              <a href="/contact" class="twh-btn twh-btn--ghost twh-btn--sm" aria-label={`Book ${slot.name} on ${dayName(day)} at ${slot.start}`}>Book</a>
                            </div>
                          </li>
                        );
                      })}
                    </ul>
                  )}

                  <p class="twh-schedule__filter-empty" hidden>
                    <span>No matching sessions on {dayName(day)}.</span>
                    <button type="button" class="twh-btn twh-btn--ghost twh-btn--sm" data-clear-filter>Show all classes</button>
                  </p>
                </div>
              );
            })}
          </div>

          <!-- ═════════════ WEEK VIEW ═════════════ -->
          <div class="twh-schedule__weekview" id="sch-weekview" hidden>
            <p class="twh-schedule__week-hint">Week at a glance — darker cells are busier. Tap any session to open its day.</p>
            <div class="twh-week">
              {DAYS.map((day, di) => {
                const d = dateLabel(dates[day]);
                return (
                  <div class={`twh-week__head${day === now.day ? ' is-today' : ''}`} style={`--day:${di}; --band:0;`} data-day={day}>
                    <span class="twh-week__dow">{day.slice(0, 3)}</span>
                    <span class="twh-week__date">{d.num} {d.month}</span>
                  </div>
                );
              })}

              {BANDS.map((band, bi) => (
                <>
                  <p class="twh-week__band-label" style={`--band-row:${bi}`}>
                    <span>{band.label}</span> {band.range}
                  </p>
                  {DAYS.map((day, di) => {
                    const list = byDay[day].filter(s => band.test(s.startMin));
                    return (
                      <div
                        class={`twh-week__cell${day === now.day ? ' is-today' : ''}`}
                        style={`--day:${di}; --band:${bi + 1}; --heat:${Math.min(list.length / 3, 1)};`}
                        data-day={day}
                        data-band={band.key}
                      >
                        <span class="twh-week__cell-label">{band.label}</span>
                        {list.length === 0 ? (
                          <span class="twh-week__none" aria-hidden="true">—</span>
                        ) : (
                          <ul role="list">
                            {list.map(s => (
                              <li>
                                <button
                                  type="button"
                                  class="twh-week__item"
                                  style={`--accent: ${s.accent.bg};`}
                                  data-goto-day={day}
                                  data-class={s.slug}
                                  data-start={s.startMin}
                                  data-end={s.endMin}
                                  aria-label={`${s.name}, ${dayName(day)} ${s.start}. Open day view`}
                                >
                                  <span class="twh-week__item-time">{s.start}</span>
                                  <span class="twh-week__item-name">{s.name}</span>
                                </button>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    );
                  })}
                </>
              ))}
            </div>
          </div>
        </>
      )}
    </div>
  </section>
</PageLayout>

<style is:global>@import '../styles/pages/twh-schedule.css';</style>

<script>
  import gsap from 'gsap';
  import { DAYS, type Day, getColomboNow, weekDates, dateLabel, colomboClockSeconds, colomboDateLong } from '../lib/utils/colombo';
  import { slotState, findNext, nextLabel, nowMinutes, STATE_LABEL, type SlotLite } from '../lib/utils/schedule';

  const root = document.querySelector<HTMLElement>('#schedule');

  if (root && root.querySelector('.twh-schedule__tabs')) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const tabs   = Array.from(root.querySelectorAll<HTMLButtonElement>('.twh-schedule__tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.twh-schedule__panel'));
    const chips  = Array.from(root.querySelectorAll<HTMLButtonElement>('.twh-schedule__chip'));
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.twh-schedule__view'));
    const dayView  = root.querySelector<HTMLElement>('#sch-dayview')!;
    const weekView = root.querySelector<HTMLElement>('#sch-weekview')!;
    const slotEls  = Array.from(root.querySelectorAll<HTMLElement>('.twh-schedule__slot'));

    // Sri Lanka "now". Starts from the device clock, then is corrected against the
    // server's clock (see syncClock) so a wrong device clock/timezone can never matter.
    let clockOffset = 0;
    const nowDate = () => new Date(Date.now() + clockOffset);

    // The visitor chose a day (tab / link / URL) → don't move them when midnight passes.
    let userPickedDay = false;

    const state = {
      day: (root.dataset.defaultDay as Day) ?? 'monday',
      cls: 'all',
      view: 'day' as 'day' | 'week',
    };

    // ── URL state (?day=&class=&view=) ───────────────────────────
    const params = new URLSearchParams(location.search);
    const pDay = params.get('day') as Day | null;
    if (pDay && (DAYS as readonly string[]).includes(pDay)) { state.day = pDay; userPickedDay = true; }
    const pClass = params.get('class');
    if (pClass && chips.some(c => c.dataset.class === pClass)) state.cls = pClass;
    if (params.get('view') === 'week') state.view = 'week';

    function syncUrl() {
      const p = new URLSearchParams();
      if (state.day !== getColomboNow(nowDate()).day) p.set('day', state.day);
      if (state.cls !== 'all') p.set('class', state.cls);
      if (state.view !== 'day') p.set('view', state.view);
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    // ── Live Sri Lanka clock, today marker, slot status, next-up ──
    const slotsLite = (): SlotLite[] =>
      slotEls.map(el => ({
        id: el.dataset.id ?? '',
        day: el.dataset.day as Day,
        startMin: Number(el.dataset.start),
        endMin: Number(el.dataset.end),
        name: el.dataset.name ?? '',
        room: el.dataset.room ?? '',
        slug: el.dataset.class ?? '',
      }));

    let lastToday = root.dataset.today;
    let lastMinuteKey = '';
    let lastDateText = '';
    const clockEl = root.querySelector<HTMLElement>('#sch-clock');
    const dateEl  = root.querySelector<HTMLElement>('#sch-date');
    const cached = slotsLite();

    /** Next-up / live banner (cheap — runs every second so countdowns tick). */
    function renderNext(now: ReturnType<typeof getColomboNow>) {
      const next = findNext(cached, now);
      const t = nextLabel(next, now);
      const box = root!.querySelector<HTMLElement>('#sch-next');
      if (!box) return t;
      box.classList.toggle('is-live', t.live);
      const set = (id: string, text: string) => {
        const el = root!.querySelector(id);
        if (el && el.textContent !== text) el.textContent = text;
      };
      set('#sch-next-kicker', t.kicker);
      set('#sch-next-title', t.title);
      set('#sch-next-detail', t.detail);
      const go = root!.querySelector<HTMLElement>('#sch-next-go');
      if (go && next) go.dataset.gotoDay = next.slot.day;
      return t;
    }

    /** Heavier work — only when the Colombo minute (or day) changes. */
    function refreshMinute(now: ReturnType<typeof getColomboNow>) {
      // New Colombo day since page load → re-date the week and move "Today"
      if (now.day !== lastToday) {
        const prevToday = lastToday;
        lastToday = now.day;
        root!.dataset.today = now.day;
        const dates = weekDates(now.dateISO, now.day);
        tabs.forEach(t => {
          const day = t.dataset.day as Day;
          t.dataset.date = dates[day];
          const d = dateLabel(dates[day]);
          t.querySelector('.twh-schedule__tab-num')!.textContent = d.num;
          t.querySelector('.twh-schedule__tab-month')!.textContent = d.month;
          t.classList.toggle('is-today', day === now.day);
          t.querySelector('.twh-schedule__tab-today')?.remove();
          if (day === now.day) {
            const tag = document.createElement('span');
            tag.className = 'twh-schedule__tab-today';
            tag.setAttribute('aria-hidden', 'true');
            tag.textContent = 'Today';
            t.append(tag);
          }
        });
        // panel headings: date line + "Today" badge follow the new dates
        panels.forEach(p => {
          const day = p.dataset.day as Day;
          const d = dateLabel(dates[day]);
          const line = p.querySelector('.twh-schedule__panel-date');
          if (line) line.innerHTML = `${d.long} <span>· Sri Lanka time</span>`;
          const title = p.querySelector('.twh-schedule__panel-title');
          title?.querySelector('.twh-schedule__panel-today')?.remove();
          if (day === now.day && title) {
            const badge = document.createElement('span');
            badge.className = 'twh-schedule__panel-today';
            badge.textContent = 'Today';
            title.append(badge);
          }
        });
        root!.querySelectorAll('.twh-week__head, .twh-week__cell').forEach(el => {
          el.classList.toggle('is-today', (el as HTMLElement).dataset.day === now.day);
        });
        root!.querySelectorAll<HTMLElement>('.twh-week__head').forEach(h => {
          const d = dateLabel(dates[h.dataset.day as Day]);
          const dateSpan = h.querySelector('.twh-week__date');
          if (dateSpan) dateSpan.textContent = `${d.num} ${d.month}`;
        });
        // Midnight passed while the visitor was just watching "today" → follow the new day
        if (!userPickedDay && state.day === prevToday) showDay(now.day, { animate: false });
      }

      const nowMin = nowMinutes(now);
      slotEls.forEach(el => {
        const isToday = el.dataset.day === now.day;
        const st = isToday ? slotState({ startMin: Number(el.dataset.start), endMin: Number(el.dataset.end) }, nowMin) : 'upcoming';
        el.dataset.state = st;
        const label = el.querySelector('[data-status]');
        if (label) label.textContent = isToday ? STATE_LABEL[st] : '';
      });

      // Week grid: which band is "now"
      root!.querySelectorAll<HTMLElement>('.twh-week__cell').forEach(c => {
        const band = c.dataset.band;
        const m = now.minutes;
        const inBand = band === 'morning' ? m < 720 : band === 'afternoon' ? m >= 720 && m < 1020 : m >= 1020;
        c.classList.toggle('is-now', c.dataset.day === now.day && inBand);
      });
    }

    /** Runs every second: live clock + date + countdown; full refresh on a new minute. */
    function tick() {
      const d = nowDate();
      const now = getColomboNow(d);

      const clockText = colomboClockSeconds(d);
      if (clockEl && clockEl.textContent !== clockText) clockEl.textContent = clockText;
      const dateText = colomboDateLong(d);
      if (dateEl && dateText !== lastDateText) { dateEl.textContent = dateText; lastDateText = dateText; }

      const key = now.dateISO + ':' + now.minutes;
      if (key !== lastMinuteKey) { lastMinuteKey = key; refreshMinute(now); }
      renderNext(now);
    }

    // Aligned to the real second so the clock never skips or stutters.
    let timer: number | undefined;
    function loop() {
      tick();
      const msToNext = 1000 - ((Date.now() + clockOffset) % 1000);
      timer = window.setTimeout(loop, msToNext + 5);
    }
    function restartLoop() {
      if (timer) window.clearTimeout(timer);
      loop();
    }

    /**
     * Correct the device clock against the server. Takes a few samples and trusts the one with the
     * shortest round trip (its midpoint error is the smallest); a slow sample is never used.
     */
    let syncing = false;
    async function syncClock() {
      if (syncing) return;
      syncing = true;
      try {
        let best: { rtt: number; offset: number } | null = null;
        for (let i = 0; i < 3; i++) {
          const t0 = Date.now();
          const res = await fetch('/api/health', { cache: 'no-store' });
          const body = await res.json();
          const t1 = Date.now();
          const server = Date.parse(body.timestamp);
          if (!Number.isFinite(server)) continue;
          const rtt = t1 - t0;
          if (!best || rtt < best.rtt) {
            best = { rtt, offset: server - (t0 + rtt / 2) };
            // Apply right away; later (faster) samples only refine it. A slow sample can be off by
            // up to rtt/2, so it is only used when the device clock is clearly wrong (> 2 s).
            if (best.rtt < 3000 || Math.abs(best.offset) > 2000) { clockOffset = best.offset; restartLoop(); }
          }
        }
      } catch { /* offline: keep using the device clock */ }
      finally { syncing = false; }
    }

    // ── Rendering state → DOM ────────────────────────────────────
    function applyFilter() {
      const q = state.cls;
      slotEls.forEach(el => { el.hidden = q !== 'all' && el.dataset.class !== q; });

      panels.forEach(p => {
        const visible = p.querySelectorAll('.twh-schedule__slot:not([hidden])').length;
        const total = p.querySelectorAll('.twh-schedule__slot').length;
        const empty = p.querySelector<HTMLElement>('.twh-schedule__filter-empty');
        if (empty) empty.hidden = !(total > 0 && visible === 0);
        const tab = tabs.find(t => t.dataset.day === p.dataset.day);
        const count = tab?.querySelector('[data-count]');
        if (count) count.textContent = String(visible);
        tab?.classList.toggle('is-empty', visible === 0);
      });

      root!.querySelectorAll<HTMLElement>('.twh-week__item').forEach(b => {
        const li = b.closest('li');
        if (li) li.hidden = q !== 'all' && b.dataset.class !== q;
      });
      root!.querySelectorAll<HTMLElement>('.twh-week__cell').forEach(c => {
        const n = c.querySelectorAll('li:not([hidden])').length;
        c.style.setProperty('--heat', String(Math.min(n / 3, 1)));
        const none = c.querySelector<HTMLElement>('.twh-week__none');
        if (none) none.hidden = false;
        c.classList.toggle('is-blank', n === 0);
      });

      chips.forEach(c => c.setAttribute('aria-pressed', c.dataset.class === q ? 'true' : 'false'));
    }

    function animateSlots(panel: HTMLElement) {
      const els = panel.querySelectorAll<HTMLElement>('.twh-schedule__slot:not([hidden])');
      if (reduced || els.length === 0) return;
      gsap.fromTo(els, { y: 18, opacity: 0 }, {
        y: 0, opacity: 1, duration: 0.45, stagger: 0.06, ease: 'power3.out', clearProps: 'transform,opacity',
      });
    }

    function showDay(day: Day, { focus = false, animate = true } = {}) {
      state.day = day;
      tabs.forEach(t => {
        const on = t.dataset.day === day;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach(p => {
        const on = p.dataset.day === day;
        p.hidden = !on;
        if (on && animate) animateSlots(p);
      });
      syncUrl();
    }

    function showView(view: 'day' | 'week') {
      state.view = view;
      dayView.hidden = view !== 'day';
      weekView.hidden = view !== 'week';
      viewBtns.forEach(b => b.setAttribute('aria-pressed', b.dataset.view === view ? 'true' : 'false'));
      if (view === 'day') {
        const p = panels.find(x => x.dataset.day === state.day);
        if (p) animateSlots(p);
      } else if (!reduced) {
        gsap.fromTo(weekView.querySelectorAll('.twh-week__cell'), { opacity: 0, y: 10 }, {
          opacity: 1, y: 0, duration: 0.4, stagger: 0.015, ease: 'power2.out', clearProps: 'transform,opacity',
        });
      }
      syncUrl();
    }

    // ── Events ───────────────────────────────────────────────────
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { userPickedDay = true; showDay(tab.dataset.day as Day); });
      tab.addEventListener('keydown', e => {
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') to = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = tabs.length - 1;
        if (to >= 0) { e.preventDefault(); userPickedDay = true; showDay(tabs[to].dataset.day as Day, { focus: true }); }
      });
    });

    chips.forEach(chip => chip.addEventListener('click', () => {
      state.cls = chip.dataset.class ?? 'all';
      applyFilter();
      const p = panels.find(x => x.dataset.day === state.day);
      if (p && state.view === 'day') animateSlots(p);
      syncUrl();
    }));

    viewBtns.forEach(b => b.addEventListener('click', () => showView(b.dataset.view as 'day' | 'week')));

    root.addEventListener('click', e => {
      const t = e.target as HTMLElement;
      const go = t.closest<HTMLElement>('[data-goto-day]');
      if (go) {
        const day = go.dataset.gotoDay as Day;
        if (state.view !== 'day') showView('day');
        userPickedDay = true;
        showDay(day);
        dayView.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        return;
      }
      if (t.closest('[data-clear-filter]')) {
        state.cls = 'all';
        applyFilter();
        syncUrl();
      }
    });

    // ── Init ─────────────────────────────────────────────────────
    applyFilter();
    showDay(state.day, { animate: false });
    showView(state.view);
    const first = panels.find(p => p.dataset.day === state.day);
    if (first && state.view === 'day') animateSlots(first);

    // Start the live clock, then correct it against the server's clock.
    loop();
    void syncClock();
    window.setInterval(syncClock, 10 * 60_000);

    // Background tabs throttle timers — resync the moment the visitor comes back.
    const wake = () => { restartLoop(); void syncClock(); };
    document.addEventListener('visibilitychange', () => { if (!document.hidden) wake(); });
    window.addEventListener('focus', wake);
    window.addEventListener('pageshow', (e) => { if (e.persisted) wake(); });
    window.addEventListener('online', wake);
  }

  // ── Page hero entrance ─────────────────────────────────────────
  const hero = document.querySelector('.twh-page-hero__inner');
  if (hero) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline();
      const eyebrow = hero.querySelector('.twh-page-hero__eyebrow');
      const heading = hero.querySelector('.twh-page-hero__heading');
      const sub     = hero.querySelector('.twh-page-hero__sub');
      if (eyebrow) tl.fromTo(eyebrow, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' });
      if (heading) tl.fromTo(heading, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.25');
      if (sub)     tl.fromTo(sub,     { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.3');
    });
  }
</script>
