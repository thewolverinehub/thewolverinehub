---
import PageLayout from '../layouts/PageLayout.astro';
import { getScheduleSlots, getGlobal } from '../lib/strapi/queries';
import type { StrapiScheduleSlot } from '../lib/strapi/types';

let global, slots: StrapiScheduleSlot[] = [];
try {
  [global, slots] = await Promise.all([getGlobal(), getScheduleSlots()]);
} catch { /* CMS offline */ }

const DAYS = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'] as const;
type Day = typeof DAYS[number];

const byDay: Record<Day, StrapiScheduleSlot[]> = {
  monday: [], tuesday: [], wednesday: [], thursday: [],
  friday: [], saturday: [], sunday: [],
};

for (const slot of slots) {
  if (slot.weekday in byDay) byDay[slot.weekday as Day].push(slot);
}

function fmt(t: string) {
  const [h, m] = t.split(':').map(Number);
  const ampm = h >= 12 ? 'PM' : 'AM';
  const h12  = h % 12 || 12;
  return `${h12}:${String(m).padStart(2, '0')} ${ampm}`;
}

const today = new Date().toLocaleDateString('en-US', { weekday: 'long' }).toLowerCase() as Day;
const defaultDay: Day = DAYS.includes(today) ? today : 'monday';

const seo = {
  metaTitle: 'Class Schedule — The Wolverine Hub',
  metaDescription: 'Browse the weekly class timetable. Find the right time for Boxing, Muay Thai, BJJ, Strength & more.',
};
---

<PageLayout {seo} {global}>
  <div class="twh-page-hero">
    <div class="twh-page-hero__inner">
      <p class="twh-page-hero__eyebrow">Timetable</p>
      <h1 class="twh-page-hero__heading">Weekly<br/>Schedule.</h1>
      <p class="twh-page-hero__sub">Classes run seven days a week. Pick a day and find your next session.</p>
    </div>
  </div>

  <section class="twh-schedule" aria-label="Class schedule">
    <div class="twh-schedule__inner">

      <!-- Day tabs -->
      <div class="twh-schedule__tabs" role="tablist" aria-label="Select a day">
        {DAYS.map(day => (
          <button
            class="twh-schedule__tab"
            role="tab"
            data-day={day}
            aria-selected={day === defaultDay ? 'true' : 'false'}
            aria-controls={`panel-${day}`}
            id={`tab-${day}`}
          >
            {day.charAt(0).toUpperCase() + day.slice(1, 3)}
            <span class="sr-only">{day.slice(2)}</span>
            {byDay[day].length > 0 && (
              <span aria-hidden="true" style="margin-left:0.25rem;font-size:0.6em;opacity:0.5">
                {byDay[day].length}
              </span>
            )}
          </button>
        ))}
      </div>

      <!-- Day panels -->
      {DAYS.map(day => (
        <div
          class="twh-schedule__panel"
          role="tabpanel"
          id={`panel-${day}`}
          aria-labelledby={`tab-${day}`}
          data-active={day === defaultDay ? 'true' : 'false'}
        >
          {byDay[day].length === 0 ? (
            <p class="twh-schedule__empty-day">No classes scheduled on {day.charAt(0).toUpperCase() + day.slice(1)}.</p>
          ) : (
            <ul class="twh-schedule__slots" role="list">
              {byDay[day].map(slot => (
                <li class="twh-schedule__slot">
                  <div class="twh-schedule__time">
                    {fmt(slot.startTime)}
                    <span class="twh-schedule__time-to">{fmt(slot.endTime)}</span>
                  </div>
                  <div>
                    <h3 class="twh-schedule__class-name">
                      {slot.class?.name ?? 'Class'}
                    </h3>
                    <div class="twh-schedule__slot-meta">
                      {slot.coach && (
                        <span class="twh-schedule__coach">{slot.coach.name}</span>
                      )}
                      {slot.room && <span>{slot.room}</span>}
                      {slot.capacity > 0 && <span>{slot.capacity} spots</span>}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}

      {slots.length === 0 && (
        <p style="text-align:center; padding:4rem 0; color:var(--color-twh-grey-600); font-size:1.125rem;">
          Schedule coming soon — <a href="/contact" style="color:var(--color-twh-yellow);">contact us</a> for class times.
        </p>
      )}
    </div>
  </section>
</PageLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Tab switching ──────────────────────────────────────────────
  const tabs   = document.querySelectorAll<HTMLButtonElement>('.twh-schedule__tab');
  const panels = document.querySelectorAll<HTMLElement>('.twh-schedule__panel');

  function switchDay(day: string) {
    tabs.forEach(t   => t.setAttribute('aria-selected', t.dataset.day === day ? 'true' : 'false'));
    panels.forEach(p => {
      const active = p.id === `panel-${day}`;
      p.dataset.active = active ? 'true' : 'false';
      if (active) animateSlots(p);
    });
  }

  function animateSlots(panel: HTMLElement) {
    const slots = panel.querySelectorAll<HTMLElement>('.twh-schedule__slot');
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.fromTo(slots,
        { x: -12, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.4, stagger: 0.05, ease: 'power2.out' }
      );
    });
    gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
      slots.forEach(s => { s.style.opacity = '1'; });
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => switchDay(tab.dataset.day ?? ''));
  });

  // Animate initial panel
  const activePanel = document.querySelector<HTMLElement>('.twh-schedule__panel[data-active="true"]');
  if (activePanel) animateSlots(activePanel);

  // Page hero entrance
  const hero = document.querySelector('.twh-page-hero__inner');
  if (hero) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline();
      const eyebrow = hero.querySelector('.twh-page-hero__eyebrow');
      const heading = hero.querySelector('.twh-page-hero__heading');
      const sub     = hero.querySelector('.twh-page-hero__sub');
      if (eyebrow) tl.fromTo(eyebrow, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' });
      if (heading) tl.fromTo(heading, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.25');
      if (sub)     tl.fromTo(sub,     { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, '-=0.3');
    });
  }
</script>
