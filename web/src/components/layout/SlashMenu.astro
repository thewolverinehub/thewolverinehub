---
import type { StrapiHeader, StrapiGlobal } from '../../lib/strapi/types';
import WolverineSlash from '../ui/WolverineSlash.astro';
import SocialLinks from '../ui/SocialLinks.astro';

interface Props {
  header?: StrapiHeader;
  global?: StrapiGlobal;
  id?: string;
}

const { header, global, id = 'main-menu' } = Astro.props;

const accentColors = ['#D7141A', '#1B3F94', '#8E0B10', '#FFC20E', '#0B2359', '#3A3A42'];

const fallbackItems = [
  { label: 'Classes',   href: '/classes',   indexNumber: '01', description: '12 classes. Pay per session.' },
  { label: 'Schedule',  href: '/schedule',  indexNumber: '02', description: 'Book your next session.' },
  { label: 'Coaches',   href: '/coaches',   indexNumber: '03', description: 'Train with the best.' },
  { label: 'Pricing',   href: '/pricing',   indexNumber: '04', description: 'Simple per-class rates.' },
  { label: 'Contact',   href: '/contact',   indexNumber: '05', description: 'Find us. Say hello.' },
];

// "Our Story" now lives on the home page only — never as a menu item (even if still present in the CMS).
const menuFromCms = (header?.menuItems ?? []).filter((m) => !/#story/.test(m.href) && m.label.trim().toLowerCase() !== 'our story');
const session = Astro.locals.session;
const items = menuFromCms.length > 0
  ? menuFromCms.map((item, i) => ({
      label: item.label,
      href: item.href,
      indexNumber: item.indexNumber ?? String(i + 1).padStart(2, '0'),
      description: item.description ?? '',
      previewImage: item.previewImage?.url,
      previewVideo: item.previewVideo?.url,
      subItems: item.subItems ?? [],
      previewAccent: accentColors[i % accentColors.length],
    }))
  : fallbackItems.map((item, i) => ({
      ...item,
      previewImage: undefined,
      previewVideo: undefined,
      subItems: [],
      previewAccent: accentColors[i % accentColors.length],
    }));
---

<div class="twh-sm" id={id} role="dialog" aria-modal="true" aria-label="Main navigation" aria-hidden="true">

  <div class="twh-sm__panels" aria-hidden="true">
    <div class="twh-sm__panel twh-sm__panel--1"></div>
    <div class="twh-sm__panel twh-sm__panel--2"></div>
    <div class="twh-sm__panel twh-sm__panel--3"></div>
  </div>

  <!-- Close button -->
  <button class="twh-sm__close" data-menu-close type="button" aria-label="Close menu">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
      <path d="M3 3L19 19M19 3L3 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="twh-sm__body">
    <nav class="twh-sm__nav" aria-label="Primary navigation">
      <ul class="twh-sm__list" role="list">
        {items.map((item) => (
          <li class="twh-sm__item">
            <a
              href={item.href}
              class="twh-sm__link"
              data-preview-image={item.previewImage}
              data-preview-video={item.previewVideo}
              data-preview-accent={item.previewAccent}
            >
              <span class="twh-sm__idx">{item.indexNumber}</span>
              <span class="twh-sm__name">{item.label}</span>
              {item.description && <span class="twh-sm__desc">{item.description}</span>}
            </a>
            {item.subItems.length > 0 && (
              <ul class="twh-sm__sub" role="list">
                {item.subItems.map((sub) => (
                  <li><a href={sub.href} class="twh-sm__sublink">{sub.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="twh-sm__preview" aria-hidden="true">
      <div class="twh-sm__preview-mask">
        <div class="twh-sm__preview-default">
          <WolverineSlash class="twh-sm__preview-slash twh-sm__preview-slash--1" />
          <WolverineSlash class="twh-sm__preview-slash twh-sm__preview-slash--2" />
          <WolverineSlash class="twh-sm__preview-slash twh-sm__preview-slash--3" />
        </div>
        <div class="twh-sm__preview-media" id="sm-preview-media"></div>
        <div class="twh-sm__preview-num" id="sm-preview-num" aria-hidden="true">01</div>
      </div>
    </div>
  </div>

  <div class="twh-sm__bar">
    <SocialLinks {global} variant="menu" class="twh-sm__socials" />
    {session ? (
      <div class="twh-sm__account">
        <a href="/account" class="twh-sm__account-link">My Account</a>
        <a href="/account/bookings" class="twh-sm__account-link">My Bookings</a>
        <form method="post" action="/api/auth/logout" data-logout-form><button type="submit" class="twh-sm__account-link twh-sm__account-link--btn">Sign out</button></form>
      </div>
    ) : (
      global?.email && <a href={`mailto:${global.email}`} class="twh-sm__contact">{global.email}</a>
    )}
  </div>
</div>

<div class="twh-sm-pill" id="mobile-pill">
  <button class="twh-sm-pill__btn" id="mobile-menu-trigger" aria-controls={id} aria-expanded="false" aria-label="Open menu" type="button">
    <svg width="16" height="11" viewBox="0 0 16 11" fill="none" aria-hidden="true">
      <rect width="16" height="2" rx="1" fill="currentColor"/>
      <rect y="4.5" width="12" height="2" rx="1" fill="currentColor"/>
      <rect y="9" width="16" height="2" rx="1" fill="currentColor"/>
    </svg>
    <span>Menu</span>
  </button>
</div>

<style>@import '../../styles/components/twh-slash-menu.css';</style>
