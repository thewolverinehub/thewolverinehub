---
import type { StrapiFooter, StrapiGlobal } from '../../lib/strapi/types';

interface Props {
  footer?: StrapiFooter;
  global?: StrapiGlobal;
}
const { footer, global } = Astro.props;
const year = new Date().getFullYear();
const siteName = global?.siteName ?? 'The Wolverine Hub';
const wordmark = footer?.wordmarkText ?? 'THE WOLVERINE HUB';

const fallbackColumns: StrapiFooter['columns'] = [
  { heading: 'Train', links: [
    { label: 'All Classes', href: '/classes',   openInNewTab: false },
    { label: 'Schedule',    href: '/schedule',  openInNewTab: false },
    { label: 'Programs',    href: '/programs',  openInNewTab: false },
    { label: 'Free Trial',  href: '/contact',   openInNewTab: false },
  ]},
  { heading: 'About', links: [
    { label: 'Our Coaches', href: '/coaches',  openInNewTab: false },
    { label: 'Pricing',     href: '/pricing',  openInNewTab: false },
    { label: 'Gallery',     href: '/gallery',  openInNewTab: false },
    { label: 'Contact',     href: '/contact',  openInNewTab: false },
  ]},
  { heading: 'Info', links: [
    { label: 'Blog', href: '/blog', openInNewTab: false },
    { label: 'FAQ',  href: '/faq',  openInNewTab: false },
  ]},
];

const columns = (footer?.columns?.length ?? 0) > 0 ? footer!.columns : fallbackColumns;

const socials = [
  { key: 'instagram', label: 'Instagram', short: 'IG', href: global?.instagram },
  { key: 'facebook',  label: 'Facebook',  short: 'FB', href: global?.facebook  },
  { key: 'youtube',   label: 'YouTube',   short: 'YT', href: global?.youtube   },
  { key: 'tiktok',    label: 'TikTok',    short: 'TT', href: global?.tiktok    },
].filter(s => s.href);
---

<footer class="twh-footer">

  <!-- Pre-footer: newsletter (optional) -->
  {footer?.newsletterEnabled && (
    <div class="twh-footer__newsletter">
      <div class="twh-footer__newsletter-inner">
        <p class="twh-footer__newsletter-eyebrow">Join the Pack</p>
        <h2 class="twh-footer__newsletter-heading">
          {footer.newsletterHeading ?? 'Train Harder. Train Smarter.'}
        </h2>
        {footer.newsletterSubheading && (
          <p class="twh-footer__newsletter-sub">{footer.newsletterSubheading}</p>
        )}
        <form class="twh-footer__newsletter-form" action="/api/newsletter" method="post" novalidate>
          <label for="footer-email" class="twh-footer__newsletter-label">Email address</label>
          <div class="twh-footer__newsletter-row">
            <input
              type="email"
              id="footer-email"
              name="email"
              placeholder="your@email.com"
              required
              aria-label="Email address"
              class="twh-footer__newsletter-input"
            />
            <button type="submit" class="twh-btn twh-btn--primary twh-btn--md">
              Join
            </button>
          </div>
        </form>
      </div>
    </div>
  )}

  <!-- Giant wordmark -->
  <div class="twh-footer__wordmark" aria-hidden="true">
    <span class="twh-footer__wordmark-text">{wordmark}</span>
  </div>

  <!-- Main grid -->
  <div class="twh-footer__grid">

    <!-- Brand column -->
    <div class="twh-footer__brand">
      <p class="twh-footer__brand-slash" aria-hidden="true">/</p>
      <p class="twh-footer__brand-name">{siteName}</p>
      {global?.siteTagline && <p class="twh-footer__brand-tagline">{global.siteTagline}</p>}

      {socials.length > 0 && (
        <div class="twh-footer__socials">
          {socials.map(s => (
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              class="twh-footer__social-link"
            >
              {s.short}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Navigation columns -->
    {columns.map((col) => (
      <div class="twh-footer__col">
        <h3 class="twh-footer__col-heading">{col.heading}</h3>
        <ul class="twh-footer__col-links" role="list">
          {col.links?.map((link) => (
            <li>
              <a
                href={link.href}
                class="twh-footer__col-link"
                target={link.openInNewTab ? '_blank' : undefined}
                rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
              >
                <span class="twh-footer__col-link-arrow" aria-hidden="true">/</span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Contact column -->
    {global && (
      <div class="twh-footer__col">
        <h3 class="twh-footer__col-heading">Contact</h3>
        <ul class="twh-footer__col-links" role="list">
          {global.email && (
            <li>
              <a href={`mailto:${global.email}`} class="twh-footer__col-link">
                <span class="twh-footer__col-link-arrow" aria-hidden="true">/</span>
                {global.email}
              </a>
            </li>
          )}
          {global.phone && (
            <li>
              <a href={`tel:${global.phone}`} class="twh-footer__col-link">
                <span class="twh-footer__col-link-arrow" aria-hidden="true">/</span>
                {global.phone}
              </a>
            </li>
          )}
          {global.whatsapp && (
            <li>
              <a href={`https://wa.me/${global.whatsapp.replace(/\D/g,'')}`} class="twh-footer__col-link" target="_blank" rel="noopener noreferrer">
                <span class="twh-footer__col-link-arrow" aria-hidden="true">/</span>
                WhatsApp
              </a>
            </li>
          )}
          {global.address && (
            <li>
              <address class="twh-footer__address">{global.address}</address>
            </li>
          )}
        </ul>
      </div>
    )}
  </div>

  <!-- Bottom bar -->
  <div class="twh-footer__bottom">
    <p class="twh-footer__copyright">
      {footer?.copyrightText ?? `© ${year} ${siteName}. All rights reserved.`}
    </p>
    {global?.companyNumber && (
      <p class="twh-footer__company">Reg. {global.companyNumber}</p>
    )}
    <nav aria-label="Legal" class="twh-footer__legal-nav">
      {footer?.legalLinks?.map((link) => (
        <a href={link.href} class="twh-footer__legal-link">{link.label}</a>
      ))}
    </nav>
  </div>

</footer>

<style>@import '../../styles/components/twh-footer.css';</style>
