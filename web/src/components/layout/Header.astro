---
import AnnouncementBar from './AnnouncementBar.astro';
import type { StrapiHeader, StrapiGlobal } from '../../lib/strapi/types';

interface Props {
  header?: StrapiHeader;
  global?: StrapiGlobal;
  menuId?: string;
}

const { header, global, menuId = 'main-menu' } = Astro.props;
const siteName = global?.siteName ?? 'The Wolverine Hub';

// Signed-in members see "My Account"; everyone else sees the CMS-driven Sign In / Sign Up button.
const session = Astro.locals.session;
const memberInitial = (session?.name ?? '').trim().charAt(0).toUpperCase();
const cta = header?.primaryCta ?? { label: 'Sign In / Sign Up', href: '/login', variant: 'primary', openInNewTab: false };
---

<AnnouncementBar {header} />

<header class="twh-header" id="site-header">
  <div class="twh-header__inner">

    <!-- Logo -->
    <a href="/" class="twh-header__logo" aria-label={`${siteName} — Home`}>
      {global?.logoLight?.url ? (
        <img
          src={global.logoLight.url}
          alt={siteName}
          width="160"
          height="44"
          class="twh-header__logo-full"
          fetchpriority="high"
        />
      ) : (
        <span class="twh-header__logo-wordmark" aria-label={siteName}>
          <span class="twh-header__logo-slash" aria-hidden="true">/</span>TWH
        </span>
      )}
      {global?.logoMonogram?.url ? (
        <img
          src={global.logoMonogram.url}
          alt=""
          width="40"
          height="40"
          class="twh-header__logo-mono"
          aria-hidden="true"
        />
      ) : (
        <span class="twh-header__logo-mono twh-header__logo-mono--text" aria-hidden="true">/</span>
      )}
    </a>

    <!-- Desktop nav (hidden — lives inside the menu) -->
    <nav class="twh-header__nav sr-only" aria-label="Primary navigation" id="primary-nav">
      {header?.menuItems?.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="twh-header__right">
      {session ? (
        <div class="twh-acctmenu" data-acctmenu>
          <button type="button" class="twh-btn twh-btn--primary twh-btn--sm twh-header__cta twh-header__account twh-acctmenu__btn" aria-haspopup="true" aria-expanded="false" aria-controls="acctmenu-panel" data-acctmenu-btn>
            <span class="twh-header__avatar" aria-hidden="true">{memberInitial}</span>
            <span class="twh-acctmenu__label">My Account</span>
            <svg class="twh-acctmenu__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="twh-acctmenu__panel" id="acctmenu-panel" role="menu" hidden data-acctmenu-panel>
            <p class="twh-acctmenu__who">{session.name}</p>
            <a href="/account" role="menuitem">Overview</a>
            <a href="/account/bookings" role="menuitem">My Bookings</a>
            <a href="/account/payments" role="menuitem">Payments</a>
            <a href="/account/messages" role="menuitem">Messages</a>
            <a href="/account/profile" role="menuitem">Profile</a>
            <form method="post" action="/api/auth/logout" data-logout-form><button type="submit" role="menuitem" class="twh-acctmenu__out">Sign out</button></form>
          </div>
        </div>
      ) : (
        <a
          href={cta.href}
          class="twh-btn twh-btn--primary twh-btn--sm twh-header__cta"
          target={cta.openInNewTab ? '_blank' : undefined}
          rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
        >
          {cta.label}
        </a>
      )}

      <!-- Menu trigger -->
      <button
        class="twh-menu-trigger"
        aria-controls={menuId}
        aria-expanded="false"
        aria-label="Open menu"
        id="menu-trigger"
        type="button"
      >
        <span class="twh-menu-trigger__bar" aria-hidden="true"></span>
        <span class="twh-menu-trigger__bar" aria-hidden="true"></span>
        <span class="twh-menu-trigger__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Scroll progress line -->
  <div class="twh-header__progress" id="scroll-progress" aria-hidden="true"></div>
</header>

<style>
  @import '../../styles/components/twh-header.css';
</style>

<script>
  // Account dropdown + "always show a fresh signed-in state" (Back button / bfcache)
  const root = document.querySelector<HTMLElement>('[data-acctmenu]');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('[data-acctmenu-btn]')!;
    const panel = root.querySelector<HTMLElement>('[data-acctmenu-panel]')!;
    const set = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      root.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => set(panel.hidden));
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
  }
  window.addEventListener('pageshow', (e) => {
    // restored from the back/forward cache: the signed-in state may be stale (e.g. after Sign out)
    if ((e as PageTransitionEvent).persisted) window.location.reload();
  });
</script>
