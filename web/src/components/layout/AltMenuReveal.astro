---
/**
 * ALTERNATIVE 1 — THE REVEAL
 * Clean full-screen overlay. Items are right-aligned large display text
 * that stagger in from below. Left side shows an abstract slash graphic
 * that morphs per item. "MENU" text trigger rotates to "CLOSE".
 * Vibe: editorial, magazine, controlled.
 */
import type { StrapiHeader, StrapiGlobal } from '../../lib/strapi/types';

interface Props {
  header?: StrapiHeader;
  global?: StrapiGlobal;
  id?: string;
}

const { header, global, id = 'main-menu' } = Astro.props;
const items = header?.menuItems ?? [];
---

<div
  class="twh-reveal-menu"
  id={id}
  role="dialog"
  aria-modal="true"
  aria-label="Main navigation"
  aria-hidden="true"
>
  <!-- Background -->
  <div class="twh-reveal-menu__bg" aria-hidden="true"></div>

  <!-- Left: abstract slash mark -->
  <div class="twh-reveal-menu__slash" aria-hidden="true">
    <svg viewBox="0 0 200 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="twh-reveal-menu__slash-svg">
      <line x1="160" y1="0" x2="40" y2="400" stroke="#D7141A" stroke-width="3" opacity="0.6"/>
      <line x1="180" y1="0" x2="60" y2="400" stroke="#FFC20E" stroke-width="2" opacity="0.4"/>
      <line x1="140" y1="0" x2="20" y2="400" stroke="#1B3F94" stroke-width="2" opacity="0.3"/>
    </svg>
    {global?.email && <a href={`mailto:${global.email}`} class="twh-reveal-menu__contact">{global.email}</a>}
  </div>

  <!-- Right: navigation -->
  <nav class="twh-reveal-menu__nav" aria-label="Primary navigation">
    <ul class="twh-reveal-menu__list" role="list">
      {items.map((item) => (
        <li class="twh-reveal-menu__item">
          <a href={item.href} class="twh-reveal-menu__link">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Socials -->
    <div class="twh-reveal-menu__socials">
      {global?.instagram && <a href={global.instagram} target="_blank" rel="noopener noreferrer" class="twh-reveal-menu__social">Instagram</a>}
      {global?.facebook  && <a href={global.facebook}  target="_blank" rel="noopener noreferrer" class="twh-reveal-menu__social">Facebook</a>}
      {global?.youtube   && <a href={global.youtube}   target="_blank" rel="noopener noreferrer" class="twh-reveal-menu__social">YouTube</a>}
    </div>
  </nav>
</div>

<style>
.twh-reveal-menu {
  position: fixed;
  inset: 0;
  z-index: 150;
  display: grid;
  grid-template-columns: 1fr 2fr;
  pointer-events: none;
  visibility: hidden;
}

.twh-reveal-menu.is-open {
  pointer-events: auto;
  visibility: visible;
}

.twh-reveal-menu__bg {
  position: absolute;
  inset: 0;
  background: var(--color-twh-black);
  transform: scaleY(0);
  transform-origin: bottom center;
  transition: transform 0.5s var(--ease-snappy);
}

.twh-reveal-menu.is-open .twh-reveal-menu__bg {
  transform: scaleY(1);
}

.twh-reveal-menu__slash {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 4rem 2rem 4rem 4rem;
  border-right: 1px solid var(--color-twh-grey-900);
  opacity: 0;
  transform: translateX(-30px);
  transition: opacity 0.4s, transform 0.4s var(--ease-snappy);
  transition-delay: 0.3s;
}

.twh-reveal-menu.is-open .twh-reveal-menu__slash {
  opacity: 1;
  transform: translateX(0);
}

.twh-reveal-menu__slash-svg {
  width: 120px;
  margin-bottom: 3rem;
}

.twh-reveal-menu__contact {
  font-size: 0.8125rem;
  color: var(--color-twh-grey-500);
  text-decoration: none;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  letter-spacing: 0.08em;
  transition: color 0.15s;
}
.twh-reveal-menu__contact:hover { color: var(--color-twh-white); }

.twh-reveal-menu__nav {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 4rem 4rem 4rem 3rem;
}

.twh-reveal-menu__list {
  list-style: none;
  padding: 0;
  margin: 0 0 3rem;
  text-align: right;
}

.twh-reveal-menu__item {
  overflow: hidden;
}

.twh-reveal-menu__link {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5.5rem);
  letter-spacing: 0.02em;
  color: var(--color-twh-white);
  text-decoration: none;
  line-height: 1.1;
  padding: 0.2rem 0;
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.5s var(--ease-snappy), opacity 0.3s, color 0.2s;
}

.twh-reveal-menu.is-open .twh-reveal-menu__link {
  transform: translateY(0);
  opacity: 1;
}

.twh-reveal-menu__item:nth-child(1) .twh-reveal-menu__link { transition-delay: 0.3s; }
.twh-reveal-menu__item:nth-child(2) .twh-reveal-menu__link { transition-delay: 0.35s; }
.twh-reveal-menu__item:nth-child(3) .twh-reveal-menu__link { transition-delay: 0.4s; }
.twh-reveal-menu__item:nth-child(4) .twh-reveal-menu__link { transition-delay: 0.45s; }
.twh-reveal-menu__item:nth-child(5) .twh-reveal-menu__link { transition-delay: 0.5s; }
.twh-reveal-menu__item:nth-child(n+6) .twh-reveal-menu__link { transition-delay: 0.55s; }

.twh-reveal-menu__link:hover { color: var(--color-twh-yellow); }

.twh-reveal-menu__socials {
  display: flex;
  justify-content: flex-end;
  gap: 1.5rem;
  opacity: 0;
  transition: opacity 0.3s;
  transition-delay: 0.65s;
}

.twh-reveal-menu.is-open .twh-reveal-menu__socials { opacity: 1; }

.twh-reveal-menu__social {
  font-size: 0.8125rem;
  color: var(--color-twh-grey-400);
  text-decoration: none;
  letter-spacing: 0.04em;
  transition: color 0.15s;
}
.twh-reveal-menu__social:hover { color: var(--color-twh-white); }

@media (max-width: 767px) {
  .twh-reveal-menu { grid-template-columns: 0 1fr; }
  .twh-reveal-menu__slash { display: none; }
  .twh-reveal-menu__nav { padding: 5rem 1.5rem 3rem; }
  .twh-reveal-menu__list { text-align: left; }
  .twh-reveal-menu__socials { justify-content: flex-start; }
}
</style>
