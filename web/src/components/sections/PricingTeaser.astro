---
import type { StrapiPricingTeaserSection, StrapiPricingTier, StrapiPass } from '../../lib/strapi/types';
import { getPricingTiers, getPasses } from '../../lib/strapi/queries';
import WolverineSlash from '../ui/WolverineSlash.astro';

interface Props {
  section?: Partial<StrapiPricingTeaserSection>;
}

const { section } = Astro.props;

const heading    = section?.heading    ?? 'Simple, Honest Pricing.';
const subheading = section?.subheading ?? 'Pick a tier. Book your first class. No lock-ins.';
const cta        = section?.cta        ?? { label: 'See All Plans', href: '/pricing', variant: 'primary', openInNewTab: false };
const anchorId   = section?.anchorId   ?? 'pricing';

let tiers: StrapiPricingTier[] = [];
let passes: StrapiPass[] = [];
try {
  [tiers, passes] = await Promise.all([getPricingTiers(), getPasses()]);
} catch { /* CMS offline */ }

const fallbackTiers: StrapiPricingTier[] = [
  { documentId: '1', name: 'Starter',        slug: 'starter',        tagline: 'Perfect for your first month', features: '2 classes/week\nAccess to open gym\nBeginner workshops',                                              isMostPopular: false, colour: 'blue',   sortOrder: 1 },
  { documentId: '2', name: 'Signature',      slug: 'signature',      tagline: 'For the committed athlete',    features: 'Unlimited classes\nPriority booking\nNutrition guide\nMonthly progress check-in',                  isMostPopular: true,  colour: 'yellow', sortOrder: 2 },
  { documentId: '3', name: 'Transformation', slug: 'transformation', tagline: 'Elite coaching + full access', features: 'Everything in Signature\n1-on-1 sessions/month\nBody composition analysis\nCustom training plan',   isMostPopular: false, colour: 'red',    sortOrder: 3 },
];

const allTiers    = tiers.length > 0 ? tiers : fallbackTiers;
const displayTiers = allTiers.slice(0, 3);
const extraCount   = Math.max(0, allTiers.length - 3);

function cheapestPrice(tierId: string): string | null {
  const tierPasses = passes.filter(p => p.tier?.documentId === tierId && p.isPurchasable);
  if (tierPasses.length === 0) return null;
  const min = Math.min(...tierPasses.map(p => p.priceLKR));
  return min.toLocaleString();
}

const toLines = (v: unknown): string[] => {
  if (!v) return [];
  if (Array.isArray(v)) return (v as string[]).filter(Boolean);
  if (typeof v === 'string') {
    const s = v.trim();
    if (s.startsWith('[')) { try { const p = JSON.parse(s); if (Array.isArray(p)) return p.filter(Boolean); } catch {} }
    return s.split('\n').filter(Boolean);
  }
  return [];
};

const tierAccent: Record<string, { top: string; price: string; check: string }> = {
  yellow: { top: 'var(--color-twh-yellow)',  price: 'var(--color-twh-yellow)',  check: 'var(--color-twh-yellow)' },
  blue:   { top: 'var(--color-twh-blue)',    price: 'rgba(255,255,255,0.9)',    check: 'var(--color-twh-blue)' },
  red:    { top: 'var(--color-twh-red)',     price: 'rgba(255,255,255,0.9)',    check: 'var(--color-twh-red)' },
  white:  { top: 'var(--color-twh-white)',   price: 'var(--color-twh-white)',   check: 'var(--color-twh-white)' },
};
---

<section class="twh-pricing" id={anchorId} aria-label="Pricing">
  <!-- Decorative wolverine scratch marks -->
  <WolverineSlash class="twh-pricing__bg-slash twh-pricing__bg-slash--l" />
  <WolverineSlash class="twh-pricing__bg-slash twh-pricing__bg-slash--r" />

  <div class="twh-pricing__inner">
    <header class="twh-pricing__header">
      <span class="twh-pricing__eyebrow">Membership</span>
      <h2 class="twh-pricing__heading">{heading}</h2>
      {subheading && <p class="twh-pricing__sub">{subheading}</p>}
    </header>

    <div class="twh-pricing__tiers">
      {displayTiers.map((tier) => {
        const price   = cheapestPrice(tier.documentId);
        const accent  = tierAccent[tier.colour] ?? tierAccent.blue;
        const features = toLines(tier.features);
        return (
          <div
            class={`twh-pricing__tier${tier.isMostPopular ? ' twh-pricing__tier--popular' : ''}`}
            style={`--tier-accent: ${accent.top};`}
          >
            {tier.isMostPopular && (
              <div class="twh-pricing__popular-bar">
                <span>Most Popular</span>
              </div>
            )}

            <div class="twh-pricing__tier-card">
              <!-- Coloured top accent line -->
              <div class="twh-pricing__tier-accent-line" aria-hidden="true" />

              <div class="twh-pricing__tier-head">
                <h3 class="twh-pricing__tier-name">{tier.name}</h3>
                {tier.tagline && <p class="twh-pricing__tier-tagline">{tier.tagline}</p>}
              </div>

              <div class="twh-pricing__price-block">
                {price ? (
                  <>
                    <span class="twh-pricing__price-from">from</span>
                    <div class="twh-pricing__price-row">
                      <span class="twh-pricing__price-currency">LKR</span>
                      <span class="twh-pricing__price-amount" style={`color: ${accent.price};`}>{price}</span>
                    </div>
                    <span class="twh-pricing__price-period">/ month</span>
                  </>
                ) : (
                  <a href="/pricing" class="twh-pricing__price-link" style={`color: ${accent.price};`}>
                    View prices →
                  </a>
                )}
              </div>

              {features.length > 0 && (
                <ul class="twh-pricing__features" role="list">
                  {features.map(f => (
                    <li class="twh-pricing__feature">
                      <span class="twh-pricing__feature-slash" aria-hidden="true" style={`color: ${accent.check};`}>/</span>
                      {f}
                    </li>
                  ))}
                </ul>
              )}

              <a
                href={`/pricing#${tier.slug}`}
                class={`twh-pricing__tier-cta twh-btn twh-btn--${tier.isMostPopular ? 'primary' : 'ghost'} twh-btn--md`}
              >
                Get Started
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="twh-pricing__footer">
      {extraCount > 0 && (
        <p class="twh-pricing__extra-note">
          + {extraCount} more plan{extraCount > 1 ? 's' : ''} available
        </p>
      )}
      <a href={cta.href} class={`twh-btn twh-btn--${cta.variant} twh-btn--md`}>
        {cta.label}
      </a>
      <p class="twh-pricing__footer-note">No lock-in contracts. Cancel anytime.</p>
    </div>
  </div>
</section>

<style>@import '../../styles/components/twh-pricing-teaser.css';</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('.twh-pricing');
  if (section) {
    const header = section.querySelector('.twh-pricing__header');
    const tiers  = section.querySelectorAll('.twh-pricing__tier');
    const footer = section.querySelector('.twh-pricing__footer');

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({ scrollTrigger: { trigger: section, start: 'top 75%' } });
      if (header) tl.fromTo(header, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out' });
      tl.fromTo(tiers,
        { y: 40, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.65, stagger: { each: 0.1, from: 'start' }, ease: 'power3.out' },
        '-=0.3'
      );
      if (footer) tl.fromTo(footer, { opacity: 0 }, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.2');
    });

    gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
      [header, ...Array.from(tiers), footer].forEach(el => {
        if (el) (el as HTMLElement).style.opacity = '1';
      });
    });
  }
</script>
