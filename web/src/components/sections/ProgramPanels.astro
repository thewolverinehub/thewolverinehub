---
import type { StrapiProgram } from '../../lib/strapi/types';
import { getPrograms } from '../../lib/strapi/queries';

interface Props {
  section?: {
    heading?: string;
    subheading?: string;
    cta?: { label: string; href: string; variant: string; openInNewTab: boolean };
    visible?: boolean;
    anchorId?: string;
  };
}

const { section } = Astro.props;

const heading  = section?.heading  ?? 'Choose Your Path.';
const anchorId = section?.anchorId ?? 'programs';

let programs: StrapiProgram[] = [];
try { programs = await getPrograms(); } catch { /* CMS offline */ }

const fallbackPrograms: StrapiProgram[] = [
  {
    documentId: '1', name: 'Combat Foundation', slug: 'combat-foundation',
    tagline: 'Learn to fight. Learn to survive.',
    shortDescription: 'The complete beginner\'s pathway through boxing, Muay Thai, and BJJ. Structured 12-week cycles with twice-weekly coaching and continuous skill assessment.',
    fromPrice: 4500, currency: 'LKR', isLimitedAvailability: false, isFeatured: true, sortOrder: 1,
  },
  {
    documentId: '2', name: 'Strength & Power', slug: 'strength-power',
    tagline: 'Build the machine.',
    shortDescription: 'Periodised strength and athletic conditioning programme designed for combat athletes and serious fitness seekers. Progressive overload, sport-specific movement patterns.',
    fromPrice: 5500, currency: 'LKR', isLimitedAvailability: false, isFeatured: false, sortOrder: 2,
  },
  {
    documentId: '3', name: 'Elite Competitor', slug: 'elite-competitor',
    tagline: 'For those who compete.',
    shortDescription: 'Full-time training for active and aspiring competitors. One-on-one coaching, competition prep, sports psychology, and nutrition support. Limited spots.',
    fromPrice: 12000, currency: 'LKR', isLimitedAvailability: true, isFeatured: false, sortOrder: 3,
  },
];

const displayPrograms = programs.length > 0 ? programs : fallbackPrograms;
---

<section class="twh-programs" id={anchorId} aria-label="Our programs">
  <div class="twh-programs__header">
    <div class="twh-programs__header-inner">
      <span class="twh-programs__eyebrow">Our programs</span>
      <h2 class="twh-programs__heading">{heading}</h2>
    </div>
  </div>

  <div class="twh-programs__panels">
    {displayPrograms.map((prog, i) => {
      const bgImage = prog.heroImage?.url ?? prog.thumbnail?.url;
      const isEven = i % 2 === 1;
      return (
        <article
          class={`twh-programs__panel${isEven ? ' twh-programs__panel--alt' : ''}`}
          aria-label={prog.name}
        >
          {bgImage ? (
            <div
              class="twh-programs__panel-bg"
              style={`background-image: url('${bgImage}');`}
              aria-hidden="true"
            />
          ) : (
            <div class="twh-programs__panel-bg twh-programs__panel-bg--placeholder" aria-hidden="true">
              <span class="twh-programs__panel-slash" aria-hidden="true">///</span>
            </div>
          )}
          <div class="twh-programs__panel-overlay" aria-hidden="true" />

          <div class="twh-programs__panel-content">
            <div class="twh-programs__panel-meta">
              <span class="twh-programs__panel-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {prog.isLimitedAvailability && (
                <span class="twh-programs__panel-limited">Limited spots</span>
              )}
            </div>

            <h3 class="twh-programs__panel-name">{prog.name}</h3>
            <p class="twh-programs__panel-tagline">{prog.tagline}</p>

            {prog.shortDescription && (
              <p class="twh-programs__panel-desc">{prog.shortDescription}</p>
            )}

            <div class="twh-programs__panel-footer">
              {prog.fromPrice && (
                <span class="twh-programs__panel-price">
                  From {prog.currency ?? 'LKR'} {prog.fromPrice.toLocaleString()}
                </span>
              )}
              <a
                href={`/programs/${prog.slug}`}
                class="twh-programs__panel-cta"
                aria-label={`Learn more about ${prog.name}`}
              >
                <span>Explore Program</span>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10h12M10 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div class="twh-programs__footer">
    <a href="/programs" class="twh-btn twh-btn--ghost twh-btn--md">
      All Programs
    </a>
  </div>
</section>

<style>@import '../../styles/components/twh-program-panels.css';</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  (function initPrograms() {
    const section = document.querySelector('.twh-programs');
    if (!section) return;

    const header = section.querySelector('.twh-programs__header');
    const panels = section.querySelectorAll('.twh-programs__panel');

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      if (header) {
        gsap.fromTo(header,
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out',
            scrollTrigger: { trigger: header, start: 'top 85%' } }
        );
      }

      panels.forEach((panel) => {
        const content = panel.querySelector('.twh-programs__panel-content');
        const bg      = panel.querySelector('.twh-programs__panel-bg');

        if (bg) {
          gsap.to(bg, {
            yPercent: -15,
            ease: 'none',
            scrollTrigger: {
              trigger: panel,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          });
        }

        if (content) {
          gsap.fromTo(content,
            { y: 40, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: panel, start: 'top 70%' } }
          );
        }
      });
    });

    gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
      panels.forEach(p => {
        const content = p.querySelector<HTMLElement>('.twh-programs__panel-content');
        if (content) { content.style.opacity = '1'; content.style.transform = 'none'; }
      });
    });
  })();
</script>
