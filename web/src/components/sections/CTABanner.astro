---
import type { StrapiCtaBannerSection } from '../../lib/strapi/types';
import WolverineSlash from '../ui/WolverineSlash.astro';

interface Props {
  section?: Partial<StrapiCtaBannerSection>;
}

const { section } = Astro.props;

const heading      = section?.heading    ?? 'Ready to Start?';
const subheading   = section?.subheading ?? 'Your first class is free. No contracts. No excuses.';
const primaryCta   = section?.primaryCta ?? { label: 'Book a Free Trial', href: '/contact', variant: 'primary', openInNewTab: false };
const secondaryCta = section?.secondaryCta;
const anchorId     = section?.anchorId ?? 'cta';
---

<section class="twh-cta-banner" id={anchorId} aria-label="Call to action">

  <!-- Background slash stack -->
  <div class="twh-cta-banner__bg" aria-hidden="true">
    <WolverineSlash class="twh-cta-banner__bg-slash" />
  </div>

  <!-- Red accent band -->
  <div class="twh-cta-banner__accent" aria-hidden="true"></div>

  <div class="twh-cta-banner__inner">

    <!-- Left: eyebrow + heading + CTAs -->
    <div class="twh-cta-banner__content">
      <p class="twh-cta-banner__eyebrow">First Class Free</p>
      <h2 class="twh-cta-banner__heading">{heading}</h2>
      {subheading && <p class="twh-cta-banner__sub">{subheading}</p>}

      <div class="twh-cta-banner__ctas">
        <a
          href={primaryCta.href}
          class="twh-btn twh-btn--primary twh-btn--lg"
          target={primaryCta.openInNewTab ? '_blank' : undefined}
          rel={primaryCta.openInNewTab ? 'noopener noreferrer' : undefined}
        >
          {primaryCta.label}
        </a>
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="twh-btn twh-btn--ghost twh-btn--lg twh-cta-banner__secondary"
            target={secondaryCta.openInNewTab ? '_blank' : undefined}
            rel={secondaryCta.openInNewTab ? 'noopener noreferrer' : undefined}
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>

    <!-- Right: stat cluster -->
    <div class="twh-cta-banner__stats" aria-hidden="true">
      <div class="twh-cta-banner__stat">
        <span class="twh-cta-banner__stat-number">100%</span>
        <span class="twh-cta-banner__stat-label">No lock-in</span>
      </div>
      <div class="twh-cta-banner__stat-divider">/</div>
      <div class="twh-cta-banner__stat">
        <span class="twh-cta-banner__stat-number">Day 1</span>
        <span class="twh-cta-banner__stat-label">Free trial</span>
      </div>
      <div class="twh-cta-banner__stat-divider">/</div>
      <div class="twh-cta-banner__stat">
        <span class="twh-cta-banner__stat-number">3+</span>
        <span class="twh-cta-banner__stat-label">Programs</span>
      </div>
    </div>

  </div>
</section>

<style>@import '../../styles/components/twh-cta-banner.css';</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('.twh-cta-banner');
  if (section) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 78%' }
      });
      const eyebrow = section.querySelector('.twh-cta-banner__eyebrow');
      const heading = section.querySelector('.twh-cta-banner__heading');
      const sub     = section.querySelector('.twh-cta-banner__sub');
      const ctas    = section.querySelector('.twh-cta-banner__ctas');
      const stats   = section.querySelectorAll('.twh-cta-banner__stat');
      const accent  = section.querySelector('.twh-cta-banner__accent') as HTMLElement | null;

      if (accent) gsap.set(accent, { scaleX: 0, transformOrigin: 'left center' });

      if (eyebrow) tl.fromTo(eyebrow, { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'power3.out' });
      if (heading) tl.fromTo(heading, { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: 'power3.out' }, '-=0.2');
      if (sub)     tl.fromTo(sub,     { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'power2.out' }, '-=0.25');
      if (ctas)    tl.fromTo(ctas,    { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'power2.out' }, '-=0.2');
      if (accent)  tl.to(accent, { scaleX: 1, duration: 0.6, ease: 'power3.out' }, 0);
      if (stats.length) tl.fromTo(stats, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out' }, '-=0.35');
    });

    gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
      const accent = section.querySelector('.twh-cta-banner__accent') as HTMLElement | null;
      if (accent) accent.style.transform = 'scaleX(1)';
    });
  }
</script>
