---
import type { StrapiClassRailSection, StrapiClass } from '../../lib/strapi/types';
import { getClasses } from '../../lib/strapi/queries';

interface Props {
  section?: Partial<StrapiClassRailSection>;
}

const { section } = Astro.props;

const heading  = section?.heading ?? 'Every Discipline. Every Level.';
const cta      = section?.cta     ?? { label: 'All Classes', href: '/classes', variant: 'ghost', openInNewTab: false };
const anchorId = section?.anchorId ?? 'classes';

const intensityColour: Record<string, string> = {
  low:     'var(--color-twh-blue)',
  medium:  'var(--color-twh-yellow)',
  high:    'var(--color-twh-red)',
  extreme: 'var(--color-twh-red-deep)',
};

let classes: StrapiClass[] = [];
try { classes = await getClasses(); } catch { /* CMS offline */ }

const fallbackClasses: StrapiClass[] = [
  { documentId: '1', name: 'Boxing',                slug: 'boxing',                tagline: 'The sweet science', durationMinutes: 60, intensity: 'high',   level: 'all',          isFree: false, price: 0, sortOrder: 1 },
  { documentId: '2', name: 'Muay Thai',             slug: 'muay-thai',             tagline: 'Eight limbs',       durationMinutes: 90, intensity: 'high',   level: 'intermediate', isFree: false, price: 0, sortOrder: 2 },
  { documentId: '3', name: 'BJJ',                   slug: 'bjj',                   tagline: 'Ground game',       durationMinutes: 90, intensity: 'medium', level: 'all',          isFree: false, price: 0, sortOrder: 3 },
  { documentId: '4', name: 'Kickboxing',            slug: 'kickboxing',            tagline: 'Power & precision', durationMinutes: 60, intensity: 'high',   level: 'all',          isFree: false, price: 0, sortOrder: 4 },
  { documentId: '5', name: 'Strength Training', slug: 'strength-conditioning', tagline: 'Build the base',  durationMinutes: 60, intensity: 'medium', level: 'all',          isFree: false, price: 0, sortOrder: 5 },
  { documentId: '6', name: 'Wrestling',             slug: 'wrestling',             tagline: 'Control the mat',   durationMinutes: 75, intensity: 'extreme',level: 'advanced',     isFree: false, price: 0, sortOrder: 6 },
  { documentId: '7', name: 'MMA',                   slug: 'mma',                   tagline: 'The complete fighter', durationMinutes: 90, intensity: 'extreme', level: 'advanced', isFree: false, price: 0, sortOrder: 7 },
  { documentId: '8', name: 'Yoga',                  slug: 'yoga',                  tagline: 'Recovery & mobility', durationMinutes: 60, intensity: 'low',  level: 'all',          isFree: false, price: 0, sortOrder: 8 },
];

const displayClasses = classes.length > 0 ? classes : fallbackClasses;
---

<section class="twh-rail" id={anchorId} aria-label="Classes">
  <div class="twh-rail__header">
    <div class="twh-rail__header-inner">
      <h2 class="twh-rail__heading">{heading}</h2>
      <a
        href={cta.href}
        class={`twh-btn twh-btn--${cta.variant} twh-btn--sm`}
        target={cta.openInNewTab ? '_blank' : undefined}
        rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
      >
        {cta.label}
      </a>
    </div>
  </div>

  <div class="twh-rail__track-wrap">
    <ul class="twh-rail__track" role="list" aria-label="Class list">
      {displayClasses.map((cls) => {
        const colour = intensityColour[cls.intensity] ?? 'var(--color-twh-grey-700)';
        return (
          <li class="twh-rail__card">
            <a href={`/classes/${cls.slug}`} class="twh-rail__card-link">
              <div class="twh-rail__card-media">
                {cls.thumbnail ? (
                  <img src={cls.thumbnail.url} alt={cls.thumbnail.alternativeText ?? cls.name} loading="lazy" />
                ) : (
                  <div class="twh-rail__card-placeholder" style={`background: linear-gradient(135deg, ${colour}33 0%, transparent 80%), var(--color-twh-ink);`}>
                    <span class="twh-rail__card-slash" aria-hidden="true">/</span>
                  </div>
                )}
                <span class="twh-rail__badge" style={`background: ${colour}; color: ${cls.intensity === 'medium' ? 'var(--color-twh-black)' : 'var(--color-twh-white)'};`}>
                  {cls.intensity}
                </span>
              </div>
              <div class="twh-rail__card-body">
                <h3 class="twh-rail__card-name">{cls.name}</h3>
                {cls.tagline && <p class="twh-rail__card-tagline">{cls.tagline}</p>}
                <div class="twh-rail__card-meta">
                  <span>{cls.durationMinutes} min</span>
                  <span>{cls.level}</span>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>@import '../../styles/components/twh-class-rail.css';</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('.twh-rail');
  if (section) {
    const header = section.querySelector('.twh-rail__header');
    const cards  = section.querySelectorAll('.twh-rail__card');

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      if (header) {
        gsap.fromTo(header,
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out',
            scrollTrigger: { trigger: section, start: 'top 85%' } }
        );
      }

      gsap.fromTo(cards,
        { y: 40, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.6, stagger: 0.07, ease: 'power3.out',
          scrollTrigger: { trigger: section, start: 'top 75%' } }
      );
    });

    gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
      cards.forEach(el => { (el as HTMLElement).style.opacity = '1'; });
    });
  }
</script>
