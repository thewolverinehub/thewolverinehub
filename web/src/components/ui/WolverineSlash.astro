---
/**
 * Three organic diagonal claw scratch marks — the Wolverine Hub brand device.
 * Filled paths simulate torn-surface claw texture at ~70° from horizontal.
 * Use currentColor + CSS opacity/size on the parent to control appearance.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
