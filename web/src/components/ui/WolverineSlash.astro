---
/**
 * Three ragged diagonal claw scratch marks — the Wolverine Hub brand device.
 * Paths simulate organic, torn-surface claw texture at ~35° angle.
 * Colour is currentColor; control opacity/size via CSS on the parent.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
