---
/**
 * Social icon row — real brand glyphs (inline SVG, currentColor), 44px tap targets, labelled for
 * screen readers. URLs come from Strapi (global). Only networks that have a URL are shown.
 * variant: "footer" (outlined squares) | "menu" (compact, inside the slash menu bar)
 */
import type { StrapiGlobal } from '../../lib/strapi/types';

interface Props {
  global?: StrapiGlobal;
  variant?: 'footer' | 'menu';
  class?: string;
}

const { global, variant = 'footer', class: cls = '' } = Astro.props;

const waDigits = (global?.whatsapp ?? '').replace(/\D/g, '');
const asUrl = (v?: string) => (v ? (/^https?:\/\//i.test(v) ? v : `https://${v}`) : undefined);

const ICONS: Record<string, string> = {
  instagram: 'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z',
  facebook: 'M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.95.4-1.7 1.8-1.7H17V3.8c-.3 0-1.3-.15-2.4-.15-2.5 0-4.1 1.5-4.1 4.2v2.6H7.7v3.3h2.8V22h3Z',
  youtube: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z',
  tiktok: 'M16.6 2h-3.1v13.1a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .8.1V9.1a6 6 0 1 0 5.2 6V8.6a7.4 7.4 0 0 0 4.3 1.4V6.9a4.3 4.3 0 0 1-4.3-4.3V2Z',
  whatsapp: 'M12.04 2a9.9 9.9 0 0 0-8.4 15.1L2 22l5-1.6A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.3 15l-.3-.2-2.9.9.9-2.8-.2-.3A8.1 8.1 0 0 1 12.04 3.8Zm-3 3.8c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3l-1.9-.9c-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.4-2.3-1.4-.8-.8-1.4-1.7-1.5-2-.2-.3 0-.4.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.1c-.2-.5-.5-.5-.7-.5Z',
};

const links = [
  { key: 'instagram', label: 'Instagram', href: asUrl(global?.instagram) },
  { key: 'facebook', label: 'Facebook', href: asUrl(global?.facebook) },
  { key: 'youtube', label: 'YouTube', href: asUrl(global?.youtube) },
  { key: 'tiktok', label: 'TikTok', href: asUrl(global?.tiktok) },
  { key: 'whatsapp', label: 'WhatsApp', href: waDigits.length >= 8 ? `https://wa.me/${waDigits}` : undefined },
].filter((l) => l.href);
---

{links.length > 0 && (
  <ul class={`twh-social twh-social--${variant} ${cls}`} role="list" aria-label="Social media">
    {links.map((l) => (
      <li>
        <a href={l.href} class={`twh-social__link twh-social__link--${l.key}`} target="_blank" rel="noopener noreferrer" aria-label={`${l.label} (opens in a new tab)`} title={l.label}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d={ICONS[l.key]} /></svg>
        </a>
      </li>
    ))}
  </ul>
)}

<style is:global>@import '../../styles/components/twh-social.css';</style>
