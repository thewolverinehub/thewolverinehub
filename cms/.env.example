# Strapi v5 — CMS environment variables
# Copy to .env for local development. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
# Public URL of this CMS — used for media URLs, preview links
# Local: http://localhost:1337 | Live: https://cms-production-3644.up.railway.app
STRAPI_URL=http://localhost:1337

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_CLIENT=postgres
# Paste the Railway public TCP proxy URL here for local dev:
# postgresql://postgres:<password>@metro.proxy.rlwy.net:<port>/railway
# On Railway the internal URL is injected automatically via ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ── Security (generate with: openssl rand -base64 32) ─────────────────────────
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ── Webhook ───────────────────────────────────────────────────────────────────
# Shared secret between Strapi webhook and the Astro /api/revalidate endpoint
WEBHOOK_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:twh_redis_secret@localhost:6379

# ── Object storage (Railway Bucket — shared for local + live) ─────────────────
BUCKET_FORCE_PATH_STYLE=false
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=
# Base URL Strapi stores in media records.
# Local: http://localhost:4321/media  |  Live: https://web-production-2a3c3.up.railway.app/media
MEDIA_BASE_URL=http://localhost:4321/media

# ── Astro web service URL (for CORS + revalidation) ───────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ── Upload limits ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=100

# ── Data sync ─────────────────────────────────────────────────────────────────
ALLOW_PUSH_TO_LIVE=false
# GO_LIVE_DATE=               # Set on Railway at launch (YYYY-MM-DD) — disables sync:push
# LIVE_CMS_URL=https://cms-production-3644.up.railway.app
# LIVE_WEB_URL=https://web-production-2a3c3.up.railway.app
# LIVE_TRANSFER_TOKEN=        # Create in live Strapi admin; delete after sync
# DATABASE_URL_LIVE=          # Used only by backup:live script
# REVALIDATE_SECRET=          # Shared with web .env
