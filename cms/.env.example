# Strapi v5 — CMS environment variables
# Copy this file to .env and fill in values for local development.
# Never commit .env — only .env.example is tracked.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Public URL of this CMS instance (used by Strapi for media URLs, preview links)
# Local:    http://localhost:1337
# Live:     https://cms-production-3644.up.railway.app
STRAPI_URL=http://localhost:1337

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wolverinehub
DATABASE_USERNAME=twh
DATABASE_PASSWORD=twh_local_secret
# On Railway, DATABASE_URL is injected automatically — leave blank locally
DATABASE_URL=

# ── Security secrets (generate with: openssl rand -base64 32) ─────────────────
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker Redis (with password set in docker-compose.yml)
REDIS_URL=redis://:twh_redis_secret@localhost:6379

# ── Object storage (MinIO locally, Railway Bucket on live) ────────────────────
BUCKET_ENDPOINT=http://localhost:9000
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=twh_access
BUCKET_SECRET_ACCESS_KEY=twh_secret_key_local
BUCKET_NAME=wolverinehub-media
# Force path-style URLs for local MinIO (set to true locally, false on Railway)
BUCKET_FORCE_PATH_STYLE=true

# ── Data sync (set ALLOW_PUSH_TO_LIVE=true locally to enable sync:push) ───────
ALLOW_PUSH_TO_LIVE=false
# GO_LIVE_DATE=         # Set this on Railway to disable sync:push after launch (format: YYYY-MM-DD)

# ── Transfer token (live only — create in Strapi admin, delete after sync) ────
# LIVE_CMS_URL=https://cms-production-3644.up.railway.app
# LIVE_TRANSFER_TOKEN=

# ── SITE_INDEXING (false = noindex on all responses) ─────────────────────────
SITE_INDEXING=false
