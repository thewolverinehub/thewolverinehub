    "ogDescription": { "type": "text", "maxLength": 200 },
    "ogImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "twitterCard": {
      "type": "enumeration",
      "enum": ["summary", "summary_large_image"],
      "default": "summary_large_image"
    },
    "structuredData": { "type": "json" }
  }
}
