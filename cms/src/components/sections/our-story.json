{
  "collectionName": "components_sections_our_stories",
  "info": {
    "displayName": "Our Story",
    "icon": "book"
  },
  "options": {},
  "attributes": {
    "eyebrow": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "label": "Small Label",
          "description": "Tiny label above the heading, e.g. \"Our Story\"."
        }
      }
    },
    "heading": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "label": "Heading",
          "description": "Big heading, e.g. \"Built in the ring. Raised by the pack.\""
        }
      }
    },
    "intro": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "label": "Intro Paragraph",
          "description": "Short paragraph under the heading."
        }
      }
    },
    "chapters": {
      "type": "json",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "label": "Story Chapters",
          "description": "JSON list. Each chapter: {\"year\":\"2019\",\"title\":\"…\",\"text\":\"…\"}. They appear in order as the visitor scrolls."
        }
      }
    },
    "quote": {
      "type": "text",
      "pluginOptions": {
        "content-manager": {
          "label": "Closing Quote",
          "description": "Big quote at the end of the story."
        }
      }
    },
    "quoteAuthor": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "label": "Quote Author",
          "description": "e.g. \"Malshan — The Wolverine\"."
        }
      }
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-button",
      "pluginOptions": {
        "content-manager": {
          "label": "Call-to-Action Button",
          "description": "Button under the story."
        }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "content-manager": {
          "label": "Visible on Page?",
          "description": "Untick to hide this section without deleting it."
        }
      }
    },
    "anchorId": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "label": "Section Anchor ID",
          "description": "Optional HTML anchor, e.g. \"story\"."
        }
      }
    }
  }
}
