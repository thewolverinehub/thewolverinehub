{
  "collectionName": "components_sections_feature_splits",
  "info": {
    "displayName": "Feature Split",
    "icon": "layer"
  },
  "options": {},
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "label": "Column Heading",
          "description": "Title above this group of footer links."
        }
      }
    },
    "body": {
      "type": "blocks",
      "pluginOptions": {
        "content-manager": {
          "label": "Body Text",
          "description": "Full body text with rich text formatting."
        }
      }
    },
    "media": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-with-alt",
      "pluginOptions": {
        "content-manager": {
          "label": "Media Asset",
          "description": "Image or video file."
        }
      }
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-button",
      "pluginOptions": {
        "content-manager": {
          "label": "Call-to-Action Button",
          "description": "Action button configuration for this section."
        }
      }
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "left",
        "right"
      ],
      "default": "right"
    },
    "backgroundToken": {
      "type": "enumeration",
      "enum": [
        "black",
        "ink",
        "blue",
        "white"
      ],
      "default": "black"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "content-manager": {
          "label": "Visible on Page?",
          "description": "Untick to hide this section without deleting it."
        }
      }
    },
    "anchorId": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "label": "Section Anchor ID",
          "description": "Optional HTML anchor for deep-linking, e.g. \"about\". Used in URLs like /page#about."
        }
      }
    }
  }
}
