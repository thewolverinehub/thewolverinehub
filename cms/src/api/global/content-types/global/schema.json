{
  "kind": "singleType",
  "collectionName": "globals",
  "info": { "singularName": "global", "pluralName": "globals", "displayName": "Global", "description": "Site-wide settings, contact info, SEO defaults, experience toggles" },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "siteName": { "type": "string", "required": true, "default": "The Wolverine Hub" },
    "siteTagline": { "type": "string" },
    "logoLight": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "logoDark": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "logoMonogram": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "favicon": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "email": { "type": "email" },
    "phone": { "type": "string" },
    "whatsapp": { "type": "string" },
    "address": { "type": "text" },
    "mapLink": { "type": "string" },
    "hoursJson": { "type": "json" },
    "instagram": { "type": "string" },
    "facebook": { "type": "string" },
    "youtube": { "type": "string" },
    "tiktok": { "type": "string" },
    "companyNumber": { "type": "string" },
    "twitterHandle": { "type": "string" },
    "defaultSeo": { "type": "component", "repeatable": false, "component": "shared.seo" },
    "experienceIntroAnimation": { "type": "boolean", "default": true },
    "experienceWebgl": { "type": "boolean", "default": true },
    "experienceSmoothScroll": { "type": "boolean", "default": true },
    "experienceCustomCursor": { "type": "boolean", "default": true },
    "experienceSoundDefault": { "type": "boolean", "default": false },
    "experienceMotionIntensity": { "type": "enumeration", "enum": ["full", "lite", "minimal"], "default": "full" }
  }
}
