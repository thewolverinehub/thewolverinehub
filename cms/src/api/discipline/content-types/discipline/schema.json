{
  "kind": "collectionType",
  "collectionName": "disciplines",
  "info": {
    "singularName": "discipline",
    "pluralName": "disciplines",
    "displayName": "Discipline",
    "description": "A training discipline (e.g. Boxing, HIIT) used to categorise classes and coaches."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "label": "Name",
          "description": "Full display name."
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "label": "URL Slug",
          "description": "URL path segment, auto-generated from the title. E.g. \"our-classes\" → /our-classes."
        }
      }
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "content-manager": {
          "label": "Icon",
          "description": "Small decorative icon image."
        }
      }
    },
    "colour": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "label": "Accent Colour",
          "description": "Colour used to style this card: Yellow, Blue, Red, or White."
        }
      }
    }
  }
}
