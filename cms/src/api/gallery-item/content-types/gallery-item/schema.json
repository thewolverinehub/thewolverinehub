{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": { "singularName": "gallery-item", "pluralName": "gallery-items", "displayName": "Gallery Item" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "media": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images", "videos"] },
    "alt": { "type": "string", "required": true },
    "caption": { "type": "string" },
    "category": { "type": "enumeration", "enum": ["training", "facility", "coaches", "community", "recovery", "food", "event"] },
    "isFeatured": { "type": "boolean", "default": false },
    "sortOrder": { "type": "integer", "default": 0 }
  }
}
