{
  "kind": "collectionType",
  "collectionName": "classes",
  "info": { "singularName": "class", "pluralName": "classes", "displayName": "Class" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "tagline": { "type": "string" },
    "description": { "type": "blocks" },
    "durationMinutes": { "type": "integer", "required": true },
    "intensity": { "type": "enumeration", "enum": ["low", "medium", "high", "extreme"], "default": "medium" },
    "level": { "type": "enumeration", "enum": ["beginner", "intermediate", "advanced", "all"], "default": "all" },
    "discipline": { "type": "relation", "relation": "manyToOne", "target": "api::discipline.discipline" },
    "thumbnail": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "previewVideo": { "type": "media", "multiple": false, "allowedTypes": ["videos"] },
    "featuredVideo": { "type": "media", "multiple": false, "allowedTypes": ["videos"] },
    "whatToExpect": { "type": "blocks" },
    "isFree": { "type": "boolean", "default": false },
    "sortOrder": { "type": "integer", "default": 0 },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
