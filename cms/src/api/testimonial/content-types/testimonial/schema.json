{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": { "singularName": "testimonial", "pluralName": "testimonials", "displayName": "Testimonial" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "quote": { "type": "text", "required": true },
    "authorName": { "type": "string", "required": true },
    "authorTitle": { "type": "string" },
    "photo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "rating": { "type": "integer", "min": 1, "max": 5, "default": 5 },
    "goal": { "type": "enumeration", "enum": ["weight-loss", "strength", "martial-arts", "endurance", "flexibility", "general-fitness", "competition"] },
    "isFeatured": { "type": "boolean", "default": false }
  }
}
