{
  "kind": "collectionType",
  "collectionName": "coaches",
  "info": { "singularName": "coach", "pluralName": "coaches", "displayName": "Coach" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "role": { "type": "string" },
    "bio": { "type": "blocks" },
    "shortBio": { "type": "text" },
    "photo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "yearsExperience": { "type": "integer" },
    "specialties": { "type": "json" },
    "disciplines": { "type": "relation", "relation": "manyToMany", "target": "api::discipline.discipline" },
    "instagram": { "type": "string" },
    "isHeadCoach": { "type": "boolean", "default": false },
    "sortOrder": { "type": "integer", "default": 0 },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
